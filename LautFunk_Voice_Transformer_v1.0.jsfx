  box(barx+norm*barw-2,bar_y-3,4,10,$xe3fff8);
  hover && right_pressed ? (notify_param(uid,udef,1);ui_edit=0;);
  hover && mouse_wheel!=0 ? (
    delta=mouse_wheel/120*ustep;notify_param(uid,max(umin,min(umax,slider(uid)+delta)),1);mouse_wheel=0;
  );
  pressed && hover ? (
    uy<cy+52 ? (ui_edit=uid;#edit="";ui_drag=0;) : (
      ui_edit=0;ui_drag=uid;dragx=barx;dragw=barw;
    );
  );
  uc+=1;
);
ui_drag>0 && down ? (
  param_info(ui_drag);nv=umin+max(0,min(1,(ux-dragx)/dragw))*(umax-umin);
