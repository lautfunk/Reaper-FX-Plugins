  ui_edit==uid ? sprintf(#value,"%s_",#edit) : ustep<1 ? sprintf(#value,"%.1f%s",slider(uid),#unit) : sprintf(#value,"%.0f%s",slider(uid),#unit);
  label(cx+14,cy+29,20,uid==6 ? $xffa6cb : $xddeaf7,#value);
  barx=cx+14;barw=209;bar_y=cy+62;norm=max(0,min(1,(slider(uid)-umin)/(umax-umin)));
