ui_cal_serial=atomic_get(cal_serial);
ui_cal_busy=atomic_get(cal_request)==1 || (cal_state==1 && cal_generation==ui_cal_serial);
// The UI watchdog also works when REAPER stops calling the audio sections.
ui_cal_busy && (time_precise()-(cal_ui_wait ? cal_ui_start : cal_start_time)>10) ? (
  atomic_set(cal_request,0);atomic_add(cal_serial,1);
  cal_ui_wait=0;cal_ui_status=4;ui_cal_busy=0;
);
cal_ui_wait && cal_generation==atomic_get(cal_serial) && cal_state>=1 && atomic_get(cal_request)==0 ? cal_ui_wait=0;
pill(359,231,133,31,ui_cal_busy ? "ABBRECHEN" : "EINMESSEN",ui_cal_busy) && pressed ? (
  ui_cal_busy ? (
    atomic_set(cal_request,0);atomic_add(cal_serial,1);cal_ui_wait=0;cal_ui_status=5;
  ) : (
    atomic_add(cal_serial,1);cal_ui_status=0;cal_ui_wait=1;cal_ui_start=time_precise();
    atomic_set(cal_request,1);
  );
);
ui_cal_busy ? sprintf(#cal,"Sprache %.1f / 2 s",cal_valid_seconds) :
  cal_ui_status==4 ? #cal="Kein Audio / Timeout" :
  cal_ui_status==5 ? #cal="Abgebrochen" :
  cal_state==2 ? sprintf(#cal,"%d Hz uebernommen",slider3) :
