// Direct entry, drag, wheel, and right-click reset all write real host sliders.
ui_key=gfx_getchar();
ui_edit>0 ? (
  ui_key==27 ? ui_edit=0;
  ui_key==8 ? strlen(#edit)>0 ? str_setlen(#edit,strlen(#edit)-1);
  ((ui_key>=48 && ui_key<=57) || ui_key==45 || ui_key==46 || ui_key==44) && strlen(#edit)<12 ? strcat(#edit,sprintf(#char,"%c",ui_key==44 ? 46 : ui_key));
  ui_key==13 ? (
    param_info(ui_edit);match("%f",#edit,entered) ? notify_param(ui_edit,max(umin,min(umax,entered)),1);
    ui_edit=0;
  );
);
hover_control=0;#footer="Regler ziehen oder Mausrad nutzen. Wert anklicken: Zahl eingeben. Rechtsklick: Standardwert.";
uc=0;loop(15,
  uid=control_ids[uc];param_info(uid);cx=28+(uc%4)*249;cy=474+floor(uc/4)*91;
  hover=hitbox(cx,cy,237,78);hover ? (hover_control=uid;#footer=#tip;);
