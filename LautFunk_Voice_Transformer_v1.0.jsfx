ui_p==3 ? (ui_hz=270;ui_size=1.27;);ui_p==4 ? (ui_hz=295;ui_size=1.32;);
ui_p==5 ? (ui_hz=230;ui_size=1.15;);
ui_p==6 ? (ui_hz=140;ui_size=.91;);ui_p==7 ? (ui_hz=160;ui_size=.95;);
ui_pitch=max(-18,min(18,slider4/100*(12*log(ui_hz/ui_base)/log(2)+slider5)));
ui_formant=max(-9,min(9,slider4/100*(12*log(ui_size/ui_src)/log(2)+slider6)));
