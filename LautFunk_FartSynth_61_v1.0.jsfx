voice_records=393216;voice_record_capacity=20086;record_stride=7;bucket_heads=2080440;bucket_capacity=12000;noise_states=2224440;curve_state=2224824;curve_capacity=1024;

// Basis tables are calculated from equations at initialization. They do not
// contain recordings or per-character audio. The 24kHz normalization matches
// the approved laboratory model; continuous evaluation supports host rates.
sh=0;
while(sh<shape_count) (
  sp=shapes+sh*8; base=basis+sh*basis_stride; q=0;
  while(q<=basis_size) (
    u=(2*q/basis_size-1)*sp[5]/sp[1]; env=exp(-.5*u*u);
    sp[0]==0 ? value=u*env : sp[0]==1 ? value=(1-u*u)*env :
    sp[0]==2 ? value=(cos(sp[2]*u)-exp(-.5*sp[2]*sp[2]))*env : value=sin(sp[2]*u)*env;
    base[q]=(value-sp[4]*env)*sp[3];
    q+=1;
  );
  sh+=1;
);
// One moderate-Q bandpass per residual band, normalized to unit white-noise RMS.
// The texture is generated anew, rather than storing residual phase or samples.
bi=0;
while(bi<16) (
  cf=noise_coeff+bi*4;
  lo=band_edges[bi]; hi=min(band_edges[bi+1],srate*.46);
  lo=min(lo,hi*.85); hz=sqrt(lo*hi); qq=hz/max(1,hi-lo);
  omega=2*$pi*hz/srate; aa=sin(omega)/(2*qq); a0=1+aa;
  cf[0]=aa/a0; cf[1]=-2*cos(omega)/a0; cf[2]=(1-aa)/a0;
  z1=0;z2=0;ee=0;q=0;nn=max(4096,ceil(srate*.25));
  while(q<nn) (
    xx=q==0 ? 1 : 0; yy=cf[0]*xx+z1;
    z1=-cf[1]*yy+z2;z2=-cf[0]*xx-cf[2]*yy;
    ee+=yy*yy;q+=1;
  );
  cf[3]=sqrt(3/max(.00000000000000000001,ee));bi+=1;
);

poly=8; previous_poly=8; steal=0; note_serial=0;
gain=10^(slider1/20); gain_target=gain;
mw=0; expr=.5; after=0; bend=0; sustain=0;
last_note=-1; last_family=0; meter_p=0; meter_open=0; meter_out=0;
last_character=-1; last_variation=-1; last_layout=-1;
all_bag_pos=60; all_bag_last=-1; all_bag_seed=91735617;
ui_note=-1; ui_gate=0; ui_playing=-1;
clock_rate=1; peak_active=0; schedule_overflow=0;
gain_smooth=1-exp(-1/(srate*.005));
release_mul=exp(-1/(srate*.180));

// Separate random stream: the shuffle never changes a voice's sound randomness.
// MIDI 96 covers all 60 combinations before reshuffling, without a seam repeat.
function next_all_choice() local(i,j,tmp,result) (
  all_bag_pos>=60 ? (
    i=0;while(i<60) (all_bag[i]=i;i+=1;);
    i=59;
    while(i>0) (
      all_bag_seed*=16807;
      all_bag_seed-=floor(all_bag_seed/2147483647)*2147483647;
      j=floor(all_bag_seed/2147483647*(i+1));
      tmp=all_bag[i];all_bag[i]=all_bag[j];all_bag[j]=tmp;i-=1;
    );
    all_bag[0]==all_bag_last ? (
      tmp=all_bag[0];all_bag[0]=all_bag[1];all_bag[1]=tmp;
    );
    all_bag_pos=0;
  );
  result=all_bag[all_bag_pos];all_bag_pos+=1;all_bag_last=result;
  result;
);

function note_down(n,velocity) local(k,f,s,i,chosen,j,mode,mm,meta,art,rep,reps,dscale,wscale,body,press,human,scatter,knots,ku,kv,a,b,c,step,center,amp,width,shape,half,start,bucket,record,head,source_time,wt,wa,ww,alt,local_t,period,rp,generation,last_end,noise,layout,variation,choice) (
  (n>=36 && n<=96) ? (
    k=n-36;layout=slider17>=.5;variation=-1;
    layout ? (
      choice=k==60 ? next_all_choice() : k;
      mode=floor(choice/5);variation=choice%5;
      f=all_variant_family[variation];s=0;
    ) : (
      f=keyfam[k];s=keystep[k];
      mode=max(0,min(11,floor(slider16+.5)));
    );
    chosen=-1; i=0;
    while(i<poly) ((chosen<0 && v_on[i]<.5) ? chosen=i; i+=1;);
    chosen<0 ? (chosen=steal; steal=(steal+1)%poly;);
    mm=mode_model[mode]; meta=model_meta+mm*16;
    note_serial+=1;v_seed[chosen]=6139+note_serial*7919+mode*1009+n*37;
    v_seed[chosen]-=floor(v_seed[chosen]/2147483646)*2147483646;v_seed[chosen]+=1;
    v_on[chosen]=1;v_note[chosen]=n;v_held[chosen]=1;v_age[chosen]=0;v_rel[chosen]=1;
    v_fam[chosen]=f;v_mode[chosen]=mode;v_model[chosen]=mm;
    v_drive[chosen]=f_drive[f]*meta[8]*(.30+.70*velocity/104);
    v_velocity[chosen]=velocity/104;v_noise[chosen]=f_noise[f];v_ring[chosen]=f_ring[f];
    v_active[chosen]=-1;v_bucket[chosen]=-1;v_active_count[chosen]=0;
    art=f_art[f];v_art[chosen]=art;reps=art==7 ? 2 : art==8 ? 3 : 1;
    press=.5+slider2/100;
    dscale=f_duration[f]*2^((slider5-50)/50)*mode_time[mode]/(f_rate[f]*(1+s*.015));
    body=2^((slider10-50)/120+(50-slider14)/100)*(.85+.30*expr);
    wscale=f_width[f]*mode_width[mode]*(1-s*.005)*body/(1+.15*(press-1));
    v_scale[chosen]=dscale;v_width[chosen]=wscale;
    period=meta[1]*dscale+.10;v_period[chosen]=period;
    v_duration[chosen]=meta[1]*dscale;v_repeats[chosen]=reps;
    v_last[chosen]=0;
    memset(bucket_heads+chosen*bucket_capacity,-1,bucket_capacity);
    memset(noise_states+chosen*32,0,32);
    human=2*(slider8/100)^2; scatter=.00032*(slider4/50+mw);
    knots=curve_state+chosen*curve_capacity;
    ku=min(curve_capacity/3-2,ceil(meta[1]/.030)+1); v_knots[chosen]=ku;
    j=0;
    while(j<=ku) (
      knots[j*3]=max(-.0012,min(.0012,normal_random(chosen)*scatter));
      knots[j*3+1]=max(.5,min(1.5,1+normal_random(chosen)*.10*human));
      knots[j*3+2]=max(.84,min(1.16,1+normal_random(chosen)*.028*human));j+=1;
    );
    v_prepare[chosen]=0;v_prepare_rep[chosen]=0;
    v_end[chosen]=period*(reps-1)+meta[1]*dscale+.25;
    meta[0]*reps>voice_record_capacity ? schedule_overflow+=1;
    last_note=n;last_family=f;
    last_character=mode;last_variation=variation;last_layout=layout;
  );
);
// Prepare upcoming atoms gradually instead of doing a whole gesture on Note On.
// The conservative ready-time bound covers every supported shape/time control.
function prepare_events(voice_id,age) local(meta,mode,f,art,reps,rep,j,ku,knots,dscale,wscale,period,rp,ready,source_time,shape,step,a,b,wt,wa,ww,alt,local_t,center,width,half,start,amp,record,bucket,head,last_end,keep) (
  mode=v_mode[voice_id];meta=model_meta+v_model[voice_id]*16;
  f=v_fam[voice_id];art=v_art[voice_id];reps=v_repeats[voice_id];rep=v_prepare_rep[voice_id];j=v_prepare[voice_id];
  ku=v_knots[voice_id];knots=curve_state+voice_id*curve_capacity;
  dscale=v_scale[voice_id];wscale=v_width[voice_id];period=v_period[voice_id];
  rp=voice_records+voice_id*voice_record_capacity*record_stride;keep=rep<reps;
  while(keep) (
    ready=(meta[9])[j]*dscale+rep*period;
    ready<=age ? (
        source_time=(meta[2])[j];shape=floor((meta[3])[j]+.5);
        step=max(0,min(ku-.0001,source_time/.030));a=floor(step);b=step-a;
        wt=knots[a*3]+b*(knots[a*3+3]-knots[a*3]);
        wa=knots[a*3+1]+b*(knots[a*3+4]-knots[a*3+1]);
        ww=knots[a*3+2]+b*(knots[a*3+5]-knots[a*3+2]);
        alt=((slider15-50)/50*f_alt[f]+mode_alt[mode])*.00055*sin(2*$pi*source_time/.013);
        local_t=source_time+wt+alt;
        // Tail shaping stretches the later part of the gesture continuously.
        local_t+=(slider7-50)/50*.10*max(0,source_time/meta[1]-.55)^2;
        art==4 ? local_t+=.12*source_time*source_time/meta[1];
        art==5 ? local_t-=.10*source_time*source_time/meta[1];
        center=local_t*dscale+rep*period;
        width=wscale*ww;
        // Keep dominant atom frequencies safely inside the host's audio band.
        width=max(width,(shapes+shape*8)[7]/(srate*.29));
        half=(shapes+shape*8)[5]*width;
        start=center-half;last_end=max(last_end,center+half);
        amp=(meta[4])[j]*wa*gesture_level(source_time,art);
        // Repeated gestures vary together, retaining the internal phase pattern.
        rep>0 ? amp*=max(.65,1-rep*.10);
        record=rp+(rep*meta[0]+j)*record_stride;
        record[0]=basis+shape*basis_stride;record[1]=0;
        record[2]=basis_size/max(.00002,2*half);record[3]=amp;
        record[5]=start;record[6]=shape>=30;
        bucket=max(0,min(bucket_capacity-1,floor(start*1000)));
        head=bucket_heads+voice_id*bucket_capacity+bucket;
        bucket<=v_bucket[voice_id] ? (
          record[1]=(age-start)*record[2];record[4]=v_active[voice_id];v_active[voice_id]=record;v_active_count[voice_id]+=1;
        ) : (record[4]=head[0];head[0]=record;);

      j+=1;
      j>=meta[0] ? (j=0;rep+=1;);
      keep=rep<reps;
    ) : keep=0;
  );
  v_prepare[voice_id]=j;v_prepare_rep[voice_id]=rep;
);
function note_up(n) local(i) (
  i=0;
  while(i<poly) (
    (v_on[i]>.5 && v_note[i]==n && v_held[i]==1) ? v_held[i]=sustain ? 2 : 0;
    i+=1;
  );
);
function control_layout(c) (
  c<8 ? (
    ui_col=c%4; ui_row=floor(c/4);
    ui_cx=24+ui_col*((gfx_w-48)/4); ui_cy=324+ui_row*83;
    ui_barw=178; ui_idx=c+2;
  ) : c<10 ? (
    ui_col=c-8; ui_row=2;
    ui_cx=24+ui_col*((gfx_w-48)/4); ui_cy=489;
    ui_barw=178; ui_idx=c+6;
  ) : (
    ui_col=c-10; ui_row=3;
    ui_cx=24+ui_col*((gfx_w-48)/5); ui_cy=572;
    ui_barw=148; ui_idx=c==10 ? 1 : c-1;
  );
);


function sync_controls() local(q) (
  poly=max(1,min(12,floor(slider11)));
  poly!=previous_poly ? (
    q=0;while(q<12) (v_on[q]=0;q+=1;);
    previous_poly=poly;steal=0;
  );
  gain_target=10^(slider1/20);
  rate_target=2^((slider3-50)/80)*max(.6,1+bend*slider13/100*.35);
  release_mul=exp(-1/(srate*max(.020,slider12/1000)));
);

@slider
sync_controls();

@block
// Also covers changes made by the custom GUI without relying on @slider.
sync_controls();
// UI key requests are read at the audio block boundary. Clicking an on-screen
// key needs a running/monitored FX chain, just like playing a MIDI keyboard.
want_gate=atomic_get(ui_gate); want_note=atomic_get(ui_note);
(ui_playing>=0 && (!want_gate || want_note!=ui_playing)) ? (
  note_up(ui_playing); ui_playing=-1;
);
(want_gate && want_note>=36 && want_note<=96 && ui_playing<0) ? (
  note_down(want_note,104); ui_playing=want_note;
);

while (midirecv(offset,msg1,msg2,msg3)) (
  status=msg1&$xF0; handled=0;
  (status==$x90 && msg3>0) ? (note_down(msg2,msg3); handled=1;);
  (status==$x80 || (status==$x90 && msg3==0)) ? (
    note_up(msg2); handled=1;
  );
  status==$xB0 ? (
    msg2==1 ? (mw=msg3/127; handled=1;);
    msg2==11 ? (expr=msg3/127; handled=1;);
    msg2==64 ? (
      old_sus=sustain; sustain=msg3>=64;
      (old_sus && !sustain) ? (
        ii=0; while(ii<poly) (
          v_held[ii]==2 ? v_held[ii]=0;
          ii+=1;
        );
      );
      handled=1;
    );
    (msg2==120 || msg2==123) ? (
      ii=0; while(ii<12) (v_on[ii]=0; ii+=1;);
      ui_playing=-1; handled=1;
    );
  );
  status==$xE0 ? (
    bend=(msg3*128+msg2-8192)/8192; handled=1;
  );
  status==$xD0 ? (after=msg2/127; handled=1;);
  !handled ? midisend(offset,msg1,msg2,msg3);
);


rate_target=2^((slider3-50)/80)*max(.6,1+bend*slider13/100*.35);


@sample
invsr=1/srate;
gain+=(gain_target-gain)*gain_smooth;
clock_rate+=(rate_target-clock_rate)*gain_smooth;
dt=clock_rate*invsr;sumL=0;p_meter=0;burst_meter=0;
pressure=.5+slider2/100;ring_control=slider9/50;air_control=slider6/25;
i=0;
while(i<poly) (
  v_on[i]>.5 ? (
    age=v_age[i];meta=model_meta+v_model[i]*16;
    v_held[i]==0 ? v_rel[i]*=release_mul;
    v_prepare_rep[i]<v_repeats[i] ? prepare_events(i,age);
    target_bucket=min(bucket_capacity-1,floor(age*1000));
    while(v_bucket[i]<target_bucket) (
      v_bucket[i]+=1;bh=bucket_heads+i*bucket_capacity+v_bucket[i];rr=bh[0];bh[0]=-1;
      while(rr>=0) (
        next=rr[4];rr[1]=(age-rr[5])*rr[2];rr[4]=v_active[i];v_active[i]=rr;
        v_active_count[i]+=1;rr=next;
      );
    );
    peak_active=max(peak_active,v_active_count[i]);
    voice=0;rr=v_active[i];prev=-1;
    while(rr>=0) (
      next=rr[4];phase=rr[1];
      phase>basis_size ? (
        prev<0 ? v_active[i]=next : prev[4]=next;
        v_active_count[i]-=1;
      ) : (
        phase>=0 ? (
          ix=min(basis_size-1,floor(phase));frac=phase-ix;tb=rr[0];
          value=(tb[ix]+frac*(tb[ix+1]-tb[ix]))*rr[3];
          rr[6]>.5 ? value*=ring_control*v_ring[i];
          voice+=value;
        );
        rr[1]+=rr[2]*dt;prev=rr;
      );
      rr=next;
    );
    // Noise envelopes follow the same gesture age as the analytic atoms.
    repeat_id=floor(age/v_period[i]);local_time=age-repeat_id*v_period[i];
    source_time=local_time/v_scale[i];noise=0;noise_meter=0;
    (air_control>0 && repeat_id<v_repeats[i] && source_time<meta[1]) ? (
      nf=meta[6];pos=source_time/.012;fr=min(nf-2,floor(pos));
      frac=fr==nf-2 ? (source_time-fr*.012)/max(.000001,meta[1]-1/24000-fr*.012) : pos-fr;
      frac=max(0,min(1,frac));bi=0;
      while(bi<16) (
        ep=meta[5]+bi*nf;env=ep[fr]+frac*(ep[fr+1]-ep[fr]);
        cf=noise_coeff+bi*4;ns=noise_states+i*32+bi*2;
        white=rand(2)-1;yy=cf[0]*white+ns[0];
        ns[0]=-cf[1]*yy+ns[1];ns[1]=-cf[0]*white-cf[2]*yy;
        noise+=yy*cf[3]*env;noise_meter+=env*env;bi+=1;
      );
      noise*=meta[7]*air_control*v_noise[i]*gesture_level(source_time,v_art[i])*max(.65,1-repeat_id*.10);
    );
    voice=(voice+noise)*v_drive[i]*pressure*v_rel[i]*(1+after*.30);
    // Prevent a new note or an extreme transformation starting on a hard edge.
    voice*=min(1,age/.001);
    sumL+=voice;v_last[i]=voice;
    burst_meter=max(burst_meter,abs(voice));p_meter=max(p_meter,min(1.5,abs(voice)*3));
    v_age[i]+=dt;
    (v_age[i]>v_end[i] || (v_held[i]==0 && v_rel[i]<.00001)) ? v_on[i]=0;
  );
  i+=1;
);
outL=sumL*gain;
abs(outL)>.95 ? outL=sign(outL)*(.95+.05*(1-exp(-(abs(outL)-.95)*20)));
spl0=outL;spl1=outL;
meter_p+=.05*(p_meter-meter_p);meter_open+=.06*(burst_meter-meter_open);
meter_out+=.06*(min(1,abs(outL))-meter_out);

@gfx 850 817
function character_name(character,dst) (
  character==0 ? strcpy(dst,"Referenz");
  character==1 ? strcpy(dst,"Tiefer");
  character==2 ? strcpy(dst,"Wechselmuster");
  character==3 ? strcpy(dst,"Runder Plopp");
  character==4 ? strcpy(dst,"Lockeres Flattern");
  character==5 ? strcpy(dst,"Feuchtes Blubbern");
  character==6 ? strcpy(dst,"Arm-Raspel");
  character==7 ? strcpy(dst,"Trocken / Kurz");
  character==8 ? strcpy(dst,"Blechern");
  character==9 ? strcpy(dst,"Tiefes Poltern");
  character==10 ? strcpy(dst,"Hohes Schnarren");
  character==11 ? strcpy(dst,"Dreifach-Brrap");
);
function variation_name(variation,dst) (
  variation==0 ? strcpy(dst,"Original");
  variation==1 ? strcpy(dst,"Kurz");
  variation==2 ? strcpy(dst,"Tief");
  variation==3 ? strcpy(dst,"Schnell");
  variation==4 ? strcpy(dst,"Wild");
);
function group_color(character) (
  character==0 ? gfx_set(.18,.88,.76);
  character==1 ? gfx_set(.26,.73,.94);
  character==2 ? gfx_set(.48,.56,.96);
  character==3 ? gfx_set(.69,.48,.93);
  character==4 ? gfx_set(.94,.40,.68);
  character==5 ? gfx_set(.97,.56,.37);
  character==6 ? gfx_set(.92,.74,.32);
  character==7 ? gfx_set(.67,.82,.35);
  character==8 ? gfx_set(.32,.78,.48);
  character==9 ? gfx_set(.30,.76,.78);
  character==10 ? gfx_set(.96,.45,.47);
  character==11 ? gfx_set(.79,.64,.93);
  character==12 ? gfx_set(.96,.96,.96);
);
down=mouse_cap&1;
// Appended host parameter 17 keeps all existing automation indices intact.
layout_button=0;
while(layout_button<2) (
  bx=gfx_w-360+layout_button*180;
  (down && !(lastmouse&1) && mouse_x>=bx && mouse_x<bx+168 && mouse_y>=14 && mouse_y<42) ? (
    slider17=1-layout_button;
    sliderchange(65536);slider_automate(65536);slider_automate(65536,1);
  );
  layout_button+=1;
);
ui_all=slider17>=.5;
gfx_set(.025,.034,.054,1); gfx_rect(0,0,gfx_w,gfx_h);
gfx_setfont(1,"Arial",23);
gfx_set(.18,.94,.85); gfx_x=22; gfx_y=14;
gfx_drawstr("LautFunk  /  FartSynth 61  v1.0");
layout_button=0;
while(layout_button<2) (
  bx=gfx_w-360+layout_button*180;
  ui_all==1-layout_button ? gfx_set(.13,.43,.45) : gfx_set(.08,.12,.17);
  gfx_rect(bx,14,168,28);
  gfx_setfont(2,"Arial",12);gfx_set(.90,.95,.96);gfx_x=bx+18;gfx_y=21;
  gfx_drawstr(layout_button==0 ? "ALLE 12" : "EIN CHARAKTER");
  layout_button+=1;
);
gfx_setfont(2,"Arial",12);
gfx_set(.63,.72,.78); gfx_x=24; gfx_y=47;
gfx_drawstr(ui_all ? "12 GRUPPEN x 5 VARIATIONEN  /  MIDI 96: ZUFALL" : "EIN CHARAKTER  /  61 TASTEN  /  17 VARIATIONSFAMILIEN");

#family="Loose Flap";
last_family==0 ? #family="Reference";
last_family==2 ? #family="Dry Pop";
last_family==3 ? #family="Long Flutter";
last_family==4 ? #family="Stutter";
last_family==5 ? #family="Air Leak";
last_family==6 ? #family="Wet Gurgle";
last_family==7 ? #family="Fast Rattle";
last_family==8 ? #family="Tight Squeak";
last_family==9 ? #family="Loose Bass";
last_family==10 ? #family="Drooping";
last_family==11 ? #family="Rising";
last_family==12 ? #family="False Start";
last_family==13 ? #family="Unstable";
last_family==14 ? #family="Double Burst";
last_family==15 ? #family="Triple Burst";
last_family==16 ? #family="Bathroom Monster";
ui_all ? (
  last_layout==1 ? character_name(last_character,#family) : #family="Alle 12 Charaktere";
) : (
  last_layout!=0 ? character_name(floor(slider16+.5),#family);
);
gfx_setfont(1,"Arial",18); gfx_set(.96,.33,.61);
gfx_x=24; gfx_y=76; gfx_drawstr(#family);
gfx_setfont(2,"Arial",12); gfx_set(.68,.76,.83);
gfx_x=260; gfx_y=81;
ui_all ? (
  last_layout==1 ? (
    variation_name(last_variation,#variant_label);
    sprintf(#state,"MIDI %d   /   %d: %s%s",last_note,last_variation+1,#variant_label,last_note==96 ? "   /   ZUFALL" : "");
  ) : #state="MIDI 36-95: Gruppen   /   MIDI 96: Zufall";
) : (
  last_layout==0 ? sprintf(#state,"MIDI %d   /   Familie %d von 17",last_note,last_family+1)
                : #state="MIDI 36-96 spielen oder eine Taste anklicken";
);
gfx_drawstr(#state);

// A character click recalls the complete single-character keyboard.
// Held voices retain the model and family selected at their note-on.
mode_button=0;
while(mode_button<12) (
  bx=24+(mode_button%4)*((gfx_w-48)/4); bw=(gfx_w-48)/4-8; by=112+floor(mode_button/4)*40;
  selected=ui_all ? last_layout==1 && last_character==mode_button : floor(slider16+.5)==mode_button;
  selected ? gfx_set(.13,.43,.45) : gfx_set(.08,.12,.17);
  gfx_rect(bx,by,bw,34);
  ui_all ? (group_color(mode_button);gfx_rect(bx,by,3,34););
  gfx_setfont(2,"Arial",ui_all ? 12 : 13); gfx_set(.90,.95,.96);
  character_name(mode_button,#character_label);
  sprintf(#mode_label,"%02d  %s",mode_button+1,#character_label);
  gfx_x=bx+12; gfx_y=by+(ui_all ? 3 : 9); gfx_drawstr(#mode_label);
  ui_all ? (
    gfx_setfont(2,"Arial",10);gfx_set(.63,.74,.80);
    sprintf(#range_label,"MIDI %d-%d",36+mode_button*5,40+mode_button*5);
    gfx_x=bx+12;gfx_y=by+19;gfx_drawstr(#range_label);
  );
  (down && !(lastmouse&1) && mouse_x>=bx && mouse_x<bx+bw && mouse_y>=by && mouse_y<by+34) ? (
    slider16=mode_button;slider17=0;
    sliderchange(98304); slider_automate(98304); slider_automate(98304,1);
  );
  mode_button+=1;
);
gfx_setfont(2,"Arial",10); gfx_set(.60,.70,.76);
gfx_x=24; gfx_y=231;
gfx_drawstr(ui_all ? "Charakter anklicken: alle 61 Variationen dieses Charakters. ALLE 12: zurueck zur Gesamtbelegung." : "Auswahl gilt ab dem naechsten Anschlag. ALLE 12: alle Charaktere gemeinsam auf der Tastatur.");

// Compact diagnostic visualization: live pressure, burst activity, output.
gfx_set(.08,.12,.17); gfx_rect(24,246,gfx_w-48,48);
gfx_setfont(2,"Arial",11);
gfx_set(.71,.79,.85); gfx_x=36; gfx_y=255; gfx_drawstr("PRESSURE");
gfx_x=310; gfx_drawstr("PULSE");
gfx_x=584; gfx_drawstr("OUTPUT");
gfx_set(.09,.20,.24); gfx_rect(36,277,225,6); gfx_rect(310,277,225,6); gfx_rect(584,277,225,6);
gfx_set(.18,.91,.76); gfx_rect(36,277,225*min(1,meter_p/1.5),6);
gfx_set(.84,.43,.96); gfx_rect(310,277,225*min(1,meter_open/.7),6);
gfx_set(.97,.35,.47); gfx_rect(584,277,225*min(1,meter_out),6);

// Fifteen controls, character buttons (16), and keyboard-mode buttons (17).
control=0;
while(control<15) (
  control_layout(control);
  cx=ui_cx; cy=ui_cy; barw=ui_barw; idx=ui_idx;
  col=ui_col; row=ui_row;
  minv=0; maxv=100;
  idx==1 ? (minv=-30; maxv=0;);
  idx==11 ? (minv=1; maxv=12;);
  idx==12 ? (minv=20; maxv=500;);
  idx==13 ? (minv=0; maxv=100;);
  #label="Pressure";
  idx==3 ? #label="Pulse Rate";
  idx==4 ? #label="Timing Variation";
  idx==5 ? #label="Air Supply";
  idx==6 ? #label="Air Texture";
  idx==7 ? #label="Tail Sputter";
  idx==8 ? #label="Humanize";
  idx==9 ? #label="Closure Ring";
  idx==1 ? #label="Output dB";
  idx==10 ? #label="Body";
  idx==11 ? #label="Voices";
  idx==12 ? #label="Release ms";
  idx==13 ? #label="Bend depth";
  idx==14 ? #label="Sharpness";
  idx==15 ? #label="Alternation";
  gfx_setfont(2,"Arial",12); gfx_set(.83,.89,.94);
  gfx_x=cx; gfx_y=cy; gfx_drawstr(#label);
  idx==1 ? sprintf(#number,"%.1f",slider(idx)) : sprintf(#number,"%d",slider(idx));
  gfx_x=cx+barw-36; gfx_drawstr(#number);
  gfx_set(.11,.16,.21); gfx_rect(cx,cy+29,barw,12);
  gfx_set(.16+.07*row,.83-.12*col/4,.88-.13*row);
  gfx_rect(cx,cy+29,barw*(slider(idx)-minv)/(maxv-minv),12);
  gfx_set(.91,.96,.97); gfx_rect(cx+barw*(slider(idx)-minv)/(maxv-minv)-2,cy+26,4,18);
  control+=1;
);
gfx_setfont(2,"Arial",12); gfx_set(.69,.77,.83);
gfx_x=24+2*((gfx_w-48)/4); gfx_y=489;
gfx_drawstr("Sharpness: narrower / wider detail");
gfx_x=24+2*((gfx_w-48)/4); gfx_y=511;
gfx_drawstr("Alternation: paired timing variation");

// Drag changes real JSFX sliders and sends REAPER automation notifications.
down=mouse_cap&1;
(!down && dragidx>0) ? (
  slider_automate(2^(dragidx-1),1);
  dragidx=0;
);
(down && !(lastmouse&1)) ? (
  dragidx=0;
  control=0;
  while(control<15) (
    control_layout(control);
    cx=ui_cx; cy=ui_cy; barw=ui_barw; idx=ui_idx;
    mouse_x>=cx && mouse_x<=cx+barw && mouse_y>=cy+20 && mouse_y<=cy+55 ? (
      dragidx=idx; dragcontrol=control;
    );
    control+=1;
  );
);
(down && dragidx>0) ? (
  control_layout(dragcontrol);
  cx=ui_cx; barw=ui_barw;
  minv=0; maxv=100; stepv=1;
  dragidx==1 ? (minv=-30; maxv=0; stepv=.1;);
  dragidx==11 ? (minv=1; maxv=12;);
  dragidx==12 ? (minv=20; maxv=500;);
  dragidx==13 ? (minv=0; maxv=100;);
  newval=minv+max(0,min(1,(mouse_x-cx)/barw))*(maxv-minv);
  newval=floor(newval/stepv+.5)*stepv;
  slider(dragidx)!=newval ? (
    slider(dragidx)=newval;
    sliderchange(2^(dragidx-1));
    slider_automate(2^(dragidx-1));
  );
);

// Five octaves plus C. Black keys are drawn above and hit-tested first.
left=24; top=649; white_h=112; black_h=70;
white_w=(gfx_w-48)/36;
hit=-1; note=36; whites=0;
while(note<=96) (
  pc=note%12; black=(pc==1||pc==3||pc==6||pc==8||pc==10);
  !black ? (
    highlighted=0; vi=0;
    while(vi<poly) (
      (v_on[vi]>.5 && v_note[vi]==note) ? highlighted=1;
      vi+=1;
    );
    highlighted ? gfx_set(.19,.92,.77) : gfx_set(.84,.89,.91);
    x=left+whites*white_w;
    gfx_rect(x,top,white_w-1,white_h);
    ui_all ? (
      group_color(floor((note-36)/5));
      gfx_rect(x,top+white_h-5,white_w-1,5);
      gfx_setfont(2,"Arial",10);gfx_set(.12,.20,.25);
      note==96 ? #key_label="?" : sprintf(#key_label,"%d",(note-36)%5+1);
      gfx_x=x+7;gfx_y=top+white_h-21;gfx_drawstr(#key_label);
      group_color(floor((note-36)/5));
    ) : (
      fam=keyfam[note-36];
      gfx_set(.22+fam*.031,.68-fam*.021,.84-fam*.012);
    );
    gfx_rect(x,top+white_h+3,white_w-1,4);
    (mouse_x>=x && mouse_x<x+white_w && mouse_y>=top && mouse_y<top+white_h) ? hit=note;
    whites+=1;
  );
  note+=1;
);
note=36; whites=0;
while(note<=96) (
  pc=note%12; black=(pc==1||pc==3||pc==6||pc==8||pc==10);
  black ? (
    highlighted=0; vi=0;
    while(vi<poly) (
      (v_on[vi]>.5 && v_note[vi]==note) ? highlighted=1;
      vi+=1;
    );
    highlighted ? gfx_set(.98,.35,.62) : gfx_set(.055,.08,.11);
    x=left+(whites-.34)*white_w;
    gfx_rect(x,top,white_w*.68,black_h);
    ui_all ? (
      group_color(floor((note-36)/5));
      gfx_rect(x,top+black_h-5,white_w*.68,5);
      gfx_setfont(2,"Arial",10);gfx_set(.88,.93,.95);
      sprintf(#key_label,"%d",(note-36)%5+1);
      gfx_x=x+4;gfx_y=top+black_h-20;gfx_drawstr(#key_label);
    );
    (mouse_x>=x && mouse_x<x+white_w*.68 && mouse_y>=top && mouse_y<top+black_h) ? hit=note;
  ) : whites+=1;
  note+=1;
);

(down && hit>=36 && dragidx==0) ? (
  atomic_set(ui_note,hit); atomic_set(ui_gate,1);
) : (
  atomic_set(ui_gate,0);
);
lastmouse=mouse_cap;

gfx_setfont(2,"Arial",11); gfx_set(.57,.65,.72);
gfx_x=24; gfx_y=gfx_h-25;
ui_all ? (
  hit>=36 && hit<96 ? (
    character_name(floor((hit-36)/5),#hover_character);
    variation_name((hit-36)%5,#hover_variation);
    sprintf(#footer,"MIDI %d  /  %02d %s  /  %d %s",hit,floor((hit-36)/5)+1,#hover_character,(hit-36)%5+1,#hover_variation);
  ) : hit==96 ? #footer="MIDI 96: Zufall aus allen 60 Kombinationen. Jede kommt einmal, dann wird neu gemischt."
              : #footer="JE GRUPPE: 1 Original  /  2 Kurz  /  3 Tief  /  4 Schnell  /  5 Wild     |     Letzte Taste: Zufall";
) : #footer="Velocity: Druck  |  CC1: Variation  |  CC11: Breite  |  Bend: Tempo  |  Aftertouch: Druck";
gfx_drawstr(#footer);
