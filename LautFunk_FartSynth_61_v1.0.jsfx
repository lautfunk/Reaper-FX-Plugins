slider17:1<0,1,1{Ein Charakter,Alle Charaktere}>-Keyboard Mode

@init
// Reference-dependent parametric resynthesis. Atom shapes are analytic.
// Stored per-event parameters retain the recordings' temporal structure.
// No claim of an independent physical or anatomical simulation is made.

function unpack24(txt,dst,bias,scale) local(q,n,value) (
  q=0; n=strlen(txt);
  while(q<n) (
    value=b64[str_getchar(txt,q)]*262144+b64[str_getchar(txt,q+1)]*4096+b64[str_getchar(txt,q+2)]*64+b64[str_getchar(txt,q+3)];
    dst[0]=(value-bias)*scale; dst+=1; q+=4;
  );
);
function uniform_random(voice_id) local(s) (
  s=v_seed[voice_id]*16807;
  s-=floor(s/2147483647)*2147483647;
  v_seed[voice_id]=s;
  s/2147483647;
);
function normal_random(voice_id) (
  sqrt(-2*log(max(.000000001,uniform_random(voice_id))))*cos(2*$pi*uniform_random(voice_id));
);
function gesture_level(t,art) local(g) (
  g=1;
  art==2 ? g=.38+.62*(.5+.5*sin(2*$pi*t*8))^2;
  art==6 ? g=1-.86*exp(-.5*((t-.07)/.018)^2);
  art==9 ? g=.75+.25*sin(t*29+.8*sin(t*11));
  g;
);

