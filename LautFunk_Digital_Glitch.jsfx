    !signal_ok ? "WARTE AUF SIGNAL" : slider24 ? "DAUERFEUER BEREIT" : "AUTOMATIK BEREIT";
  color(0.72,0.81,0.87);
);
label(43,388,14,#status);
color(0.63,0.73,0.80);
