// MATRIX. Real probability per key; FartSynth-style 61-note keyboard.
ui_tab==3 ? (
  ui_panel(24,132,gfx_w-48,562);
  gfx_setfont(1,"Arial",18);ui_set_accent(1);ui_text(42,148,"61-KEY PROBABILITY MATRIX");
  gfx_setfont(2,"Arial",11);gfx_set(.63,.74,.8,1);
  ui_text(42,180,"DRAG A BAR TO CHANGE THE PLAYING PROBABILITY OF THAT NOTE.  THE KEYBED SHOWS ACTIVE VOICES.");
  x=44;w=gfx_w-88;barw=w/61;by=245;bh=270;
  k=0;
  loop(61,
    idx=195+k;v=slider(idx);
    bx=x+k*barw;
    gfx_set(.12,.17,.24,1);gfx_rect(bx,by,barw-2,bh);
    active=0;j=0;
    loop(128,V_ON[j]>.5 && V_PITCH[j]==iround(slider5)+k ? active=1;j+=1;);
    active ? gfx_set(.99,.35,.59,1) : gfx_set(.18,.78,.69,1);
    gfx_rect(bx,by+bh*(1-v/100),barw-2,bh*v/100);
    gfx_set(.07,.11,.15,1);gfx_rect(bx,by+bh-1,barw-2,1);
    (ui_click && mouse_x>=bx && mouse_x<bx+barw && mouse_y>=by && mouse_y<=by+bh) ? ui_drag=idx;
    ui_down && ui_drag==idx ? (
      nv=iround(clamp(100*(1-(mouse_y-by)/bh),0,100));
      slider(idx)!=nv ? (slider(idx)=nv;sliderchange(slider(idx));slider_automate(slider(idx)););
    );
    k+=1;
  );
  draw_keys(44,535,gfx_w-88,109);
  gfx_setfont(2,"Arial",11);gfx_set(.63,.74,.8,1);
  sprintf(#keyinfo,"BASE MIDI NOTE %d  -  %d  |  %d ACTIVE NOTES",iround(slider5),iround(slider5)+60,voices);
  ui_text(44,658,#keyinfo);
);
