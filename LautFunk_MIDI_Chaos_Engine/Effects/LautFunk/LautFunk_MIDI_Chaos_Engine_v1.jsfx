  P_NOTE[12]=40;P_GATE[12]=25;P_VEL[12]=65;P_PROB[12]=100;
  P_NOTE[13]=-1;P_GATE[13]=0;P_VEL[13]=0;P_PROB[13]=0;
  P_NOTE[14]=41;P_GATE[14]=95;P_VEL[14]=100;P_PROB[14]=100;
  P_NOTE[15]=40;P_GATE[15]=20;P_VEL[15]=50;P_PROB[15]=100;
  P_NOTE[32]=59;P_GATE[32]=20;P_VEL[32]=85;P_PROB[32]=100;
  P_NOTE[33]=-1;P_GATE[33]=0;P_VEL[33]=0;P_PROB[33]=0;
