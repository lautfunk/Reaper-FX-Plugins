  ui_button(228,306,171,24,"AMBIENT ORBIT",P_CTL[2]==6) ? P_CTL[2]=6;
  ui_button(412,306,171,24,"E-GRAVITY",P_CTL[2]==7) ? P_CTL[2]=7;
