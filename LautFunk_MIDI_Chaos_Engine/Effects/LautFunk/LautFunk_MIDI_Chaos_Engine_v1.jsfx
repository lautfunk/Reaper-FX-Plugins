// ENGINES. Each engine runs its own rhythm & Euclidean pattern.
ui_tab==1 ? (
  i=0;
  loop(4,
    col=i%2;row=floor(i/2);
    x=24+col*((gfx_w-48)/2+5);y=133+row*281;w=(gfx_w-58)/2;h=270;
    ui_panel(x,y,w,h);
    gfx_setfont(1,"Arial",17);ui_set_accent(1);
    sprintf(#eng,"ENGINE %d   /   MIDI CHANNEL %d",i+1,iround(slider(55+i*8)));
    ui_text(x+16,y+14,#eng);
    k=0;
    loop(8,
      col2=k%2;row2=floor(k/2);
      param=51+i*8+k;
      #lbl="";
      k==0 ? #lbl="Enable";k==1 ? #lbl="Steps / beat";k==2 ? #lbl="Probability";
      k==3 ? #lbl="Note length %";k==4 ? #lbl="MIDI channel";k==5 ? #lbl="Pitch spread";
      k==6 ? #lbl="Euclid hits";k==7 ? #lbl="Euclid steps";
      ui_knob(param,x+16+col2*(w/2),y+55+row2*51,w/2-29,#lbl);
      k+=1;
    );
    i+=1;
  );
);
