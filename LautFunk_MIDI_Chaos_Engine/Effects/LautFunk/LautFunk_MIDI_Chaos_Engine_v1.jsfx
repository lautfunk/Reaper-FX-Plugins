    gfx_set(.11,.17,.23,1);gfx_rect(x,y,29,40);
    gfx_set(.18,.83,.75,1);gfx_rect(x,y+40-stepval*.34,29,stepval*.34);
    ui_click && mouse_x>=x && mouse_x<x+29 && mouse_y>=y && mouse_y<y+40 ? ui_edit_step=i;
    i+=1;
  );
  sprintf(#stepnow,"EDIT ENGINE %d / STEP %d",ui_edit_engine+1,ui_edit_step+1);
  gfx_setfont(2,"Arial",12);gfx_set(.94,.84,.60,1);ui_text(45,593,#stepnow);
  ui_step_control(45,623,190,"PITCH DEGREE (-7..7)",0,-7,99,1);
