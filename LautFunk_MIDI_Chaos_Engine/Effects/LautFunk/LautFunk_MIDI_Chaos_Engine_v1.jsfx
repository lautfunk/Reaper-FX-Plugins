 M_CFG[60]=2;M_CFG[61]=1;M_CFG[62]=8;
 M_CFG[63]=1200;
 j=0;loop(4,
    k=0;loop(32,
      // 0, minor third, fifth and occasional scale-second; 99 means intentional rest.
      M_SEQ[j*32+k]= k%7==0 ? 0 : k%7==2 ? 4 : k%7==4 ? 1 : k%7==6 ? 0 : 99;
      M_GATE[j*32+k]= k%9==0 ? 100 : k%9==3 ? 100 : k%9==6 ? 100 : k%9==1 ? 30 : k%9==7 ? 24 : 0;
      M_VEL[j*32+k]= k%9==0 ? 122 : k%9==3 ? 106 : k%9==6 ? 116 : 65;
      k+=1;
    );j+=1;
 );
 M_CASCADE[0]=0;M_CASCADE[1]=0;M_CASCADE[2]=3;M_CASCADE[3]=0;
 M_CASCADE[4]=5;M_CASCADE[5]=0;M_CASCADE[6]=-2;M_CASCADE[7]=0;
);

// Independent migration: keeps old projects' M_CFG, scene slots and MIDI automation.
M_EXT[31]<1300 ? (
 M_EXT[0]=0; // 0=off; 1=sus2;2=sus4;3=quartal;4=power;5=phrygian cluster
 M_EXT[1]=0; // 0=allow progressions;1=static drone;2=oscillating mode;3=modal wander
 M_EXT[2]=0;M_EXT[3]=28; // b2 motif enable, fill probability
 M_EXT[4]=0;M_EXT[5]=1; // pedal point enable and density 1..8
 M_EXT[6]=58;M_EXT[7]=110; // relative anchor and lead accents
 M_EXT[8]=0;M_EXT[9]=8; // voicing drift, 8-bar interval
 M_EXT[10]=0;M_EXT[11]=4; // order morph enable and duration bars
 M_EXT[12]=0;M_EXT[13]=30;M_EXT[14]=4; // ratchets enable, chance, retrigger count
 M_EXT[15]=0;M_EXT[16]=1;M_EXT[17]=2;M_EXT[18]=60; // canon on, delay unit, transpose, level
 M_EXT[19]=0;M_EXT[20]=5; // optional rare tritone mutation, chance
 M_EXT[21]=0;M_EXT[22]=0; // sound gate not supported; reserved; NO fake audio gate
 M_EXT[31]=1300;
);


// Non-destructive migration: old v1.3 projects keep their notes, scenes and parameters.
P_CTL[63]<1400 ? (
  P_CTL[0]=0; // POLYTRANCE OFF until activated explicitly
  P_CTL[1]=1; // 32-bar flow enabled
  P_CTL[2]=0; // 0=reference, 1=phase drift, 2=spiral, 3=shadow, 4=quantum
  P_CTL[3]=32; // Arrangement period (bars; fixed 8 x 4 stages for v1.4)
  P_CTL[4]=0; // 0=never reset 560-step phase on bar 33
  P_CTL[5]=55;P_CTL[6]=35; // Pressure & Space macros
  P_CTL[7]=18; // creative movement amount
  P_CTL[8]=0; // per-lane speed drift, 0 preserves exact 16:7:5 loop
  P_CTL[9]=0; // transpose all tracks in semitones
  P_CTL[10]=0; // 0=current tempo 16th, 1=8th, 2=32nd
  P_CTL[11]=0; // gentle echo switch; 0=off
  P_CTL[12]=0; // hard MIDI panic on reset (no arbitrary SYSEX)
  P_CTL[13]=0; // hold original harmony: if on, mutations cannot escape E Phrygian
  P_CTL[14]=0; // reserved
  P_CTL[15]=0; // reserved
  P_CTL[16]=16;P_CTL[17]=7;P_CTL[18]=5; // length per lane
  P_CTL[20]=1;P_CTL[21]=1;P_CTL[22]=1; // enabled per lane
  P_CTL[24]=1;P_CTL[25]=2;P_CTL[26]=3; // output channels, 1-based
  P_CTL[28]=100;P_CTL[29]=100;P_CTL[30]=100; // velocity scale
  P_CTL[32]=100;P_CTL[33]=100;P_CTL[34]=100; // gate scale
  P_CTL[36]=0;P_CTL[37]=0;P_CTL[38]=0; // lane transposition in semitones
  P_CTL[40]=0;P_CTL[41]=0;P_CTL[42]=0; // per-lane swing (0..35%)
  P_CTL[44]=74;P_CTL[45]=71;P_CTL[46]=75;P_CTL[47]=91;P_CTL[48]=93; // MIDI CC mappings
  P_CTL[50]=0; // extra ghost notes level
  P_CTL[51]=0; // mutation gates probability
  P_CTL[52]=30; // evolving tension amount
  P_CTL[53]=100; // locked anchors
  P_CTL[54]=25; // mutation depth
  P_CTL[55]=60; // intensity / audio spacing
  P_CTL[56]=0; // channel 1 slide on step 15/16 (CC65 & CC5)
  P_CTL[57]=35; // CC5 portamento time
  P_CTL[58]=0; // reserved
  P_CTL[59]=0; // reserved
  P_CTL[60]=1; // send MIDI CC expression
  P_CTL[61]=0; // debug option
  P_CTL[62]=0; // scene reserve
  P_CTL[63]=1400;
  P_NOTE[0]=40;P_GATE[0]=25;P_VEL[0]=70;P_PROB[0]=100;
