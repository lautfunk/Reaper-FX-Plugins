  ui_button(665,267,290,33,"TRACK 3 / 5-STEP",ui_poly_lane==2) ? ui_poly_lane=2;
  ui_button(970,267,110,33,P_CTL[20+ui_poly_lane]>.5?"LANE ON":"LANE OFF",P_CTL[20+ui_poly_lane]>.5) ? (
