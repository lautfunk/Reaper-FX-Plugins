// Versioned migration: never wipe a user's existing harmony settings.
M_CFG[63]<1200 ? (
 M_CFG[24]=1;M_CFG[25]=85;M_CFG[26]=55;M_CFG[27]=25;
 M_CFG[28]=65;M_CFG[29]=35;M_CFG[30]=45;M_CFG[31]=0;
 M_CFG[44]=1;M_CFG[45]=1;M_CFG[46]=1;M_CFG[47]=1;
 M_CFG[48]=7;M_CFG[49]=11;M_CFG[50]=5;M_CFG[51]=13;
