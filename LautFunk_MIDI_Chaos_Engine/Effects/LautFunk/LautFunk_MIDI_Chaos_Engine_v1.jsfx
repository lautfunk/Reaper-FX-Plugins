  i=0;loop(32,
    x=45+i*31.5;y=454;
    stepval=M_SEQ[ui_edit_engine*32+i];
    selected=ui_edit_step==i;
    gfx_set(selected?.17:.10,selected?.52:.19,selected?.49:.24,1);
    gfx_rect(x,y,29,39);
    gfx_set(.83,.92,.94,1);gfx_x=x+4;gfx_y=y+14;
    stepval==99 ? gfx_drawstr("-") : (sprintf(#stepname,"%d",iround(stepval));gfx_drawstr(#stepname););
    ui_click && mouse_x>=x && mouse_x<x+29 && mouse_y>=y && mouse_y<y+39 ? ui_edit_step=i;
    i+=1;
  );
  gfx_setfont(2,"Arial",12);gfx_set(.80,.89,.93,1);
