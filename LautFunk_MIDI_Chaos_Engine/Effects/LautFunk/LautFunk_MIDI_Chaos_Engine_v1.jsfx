  P_NOTE[37]=65;P_GATE[37]=70;P_VEL[37]=115;P_PROB[37]=50;
  P_NOTE[38]=57;P_GATE[38]=35;P_VEL[38]=80;P_PROB[38]=100;
  P_NOTE[64]=76;P_GATE[64]=10;P_VEL[64]=95;P_PROB[64]=100;
  P_NOTE[65]=-1;P_GATE[65]=0;P_VEL[65]=0;P_PROB[65]=0;
  P_NOTE[66]=-1;P_GATE[66]=0;P_VEL[66]=0;P_PROB[66]=0;
  P_NOTE[67]=77;P_GATE[67]=15;P_VEL[67]=115;P_PROB[67]=40;
  P_NOTE[68]=71;P_GATE[68]=10;P_VEL[68]=70;P_PROB[68]=100;
  P_ARR[0]=25;
  P_ARR[1]=0;
  P_ARR[2]=0;
  P_ARR[3]=0;
  P_ARR[4]=0;
  P_ARR[5]=15;
  P_ARR[6]=0;
  P_ARR[7]=16;
  P_ARR[8]=0;
  P_ARR[9]=40;
  P_ARR[10]=35;
  P_ARR[11]=0;
  P_ARR[12]=65;
  P_ARR[13]=0;
  P_ARR[14]=55;
  P_ARR[15]=15;
  P_ARR[16]=16;
  P_ARR[17]=0;
  P_ARR[18]=55;
  P_ARR[19]=60;
  P_ARR[20]=0;
  P_ARR[21]=100;
  P_ARR[22]=0;
  P_ARR[23]=50;
  P_ARR[24]=40;
  P_ARR[25]=16;
  P_ARR[26]=0;
  P_ARR[27]=70;
  P_ARR[28]=70;
  P_ARR[29]=15;
  P_ARR[30]=100;
  P_ARR[31]=18;
  P_ARR[32]=60;
  P_ARR[33]=55;
  P_ARR[34]=16;
  P_ARR[35]=0;
  P_ARR[36]=70;
  P_ARR[37]=75;
  P_ARR[38]=80;
  P_ARR[39]=100;
  P_ARR[40]=75;
  P_ARR[41]=35;
  P_ARR[42]=70;
  P_ARR[43]=12;
  P_ARR[44]=0;
  P_ARR[45]=85;
  P_ARR[46]=85;
  P_ARR[47]=100;
  P_ARR[48]=100;
