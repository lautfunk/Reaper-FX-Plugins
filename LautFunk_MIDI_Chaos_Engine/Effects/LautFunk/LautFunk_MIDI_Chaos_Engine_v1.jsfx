    playhi=(P_STEP[ui_poly_lane]%max(1,lane_len))==pn;
    gfx_set(playhi?.09:.05,playhi?.32:.11,playhi?.30:.16,1);
    gfx_rect(xx,333,58,58);
    gfx_set(.12,.29,.33,1);gfx_rect(xx,333,58,2);
    gfx_setfont(2,"Arial",11);gfx_set(.88,.94,.96,1);
    sprintf(#polysid,"%d",pn+1);ui_text(xx+5,338,#polysid);
    pn<lane_len ? (pnote<0 ? strcpy(#polysval,"---") : sprintf(#polysval,"%d",iround(pnote));) : strcpy(#polysval,"--");
    ui_text(xx+10,360,#polysval);
    ui_button(xx,399,58,22,"EDIT",ui_poly_step==pn) ? ui_poly_step=pn;
    i+=1;
  );
  lane_pos=ui_poly_lane*32+ui_poly_step;
