  P_NOTE[9]=53;P_GATE[9]=30;P_VEL[9]=90;P_PROB[9]=100;
  P_NOTE[10]=40;P_GATE[10]=20;P_VEL[10]=55;P_PROB[10]=100;
  P_NOTE[11]=60;P_GATE[11]=75;P_VEL[11]=120;P_PROB[11]=40;
  P_NOTE[12]=40;P_GATE[12]=25;P_VEL[12]=65;P_PROB[12]=100;
  P_NOTE[13]=-1;P_GATE[13]=0;P_VEL[13]=0;P_PROB[13]=0;
  P_NOTE[14]=41;P_GATE[14]=95;P_VEL[14]=100;P_PROB[14]=100;
  P_NOTE[15]=40;P_GATE[15]=20;P_VEL[15]=50;P_PROB[15]=100;
  P_NOTE[32]=59;P_GATE[32]=20;P_VEL[32]=85;P_PROB[32]=100;
  P_NOTE[33]=-1;P_GATE[33]=0;P_VEL[33]=0;P_PROB[33]=0;
  P_NOTE[34]=62;P_GATE[34]=55;P_VEL[34]=105;P_PROB[34]=100;
  P_NOTE[35]=64;P_GATE[35]=25;P_VEL[35]=70;P_PROB[35]=100;
  P_NOTE[36]=-1;P_GATE[36]=0;P_VEL[36]=0;P_PROB[36]=0;
  P_NOTE[37]=65;P_GATE[37]=70;P_VEL[37]=115;P_PROB[37]=50;
  P_NOTE[38]=57;P_GATE[38]=35;P_VEL[38]=80;P_PROB[38]=100;
  P_NOTE[64]=76;P_GATE[64]=10;P_VEL[64]=95;P_PROB[64]=100;
  P_NOTE[65]=-1;P_GATE[65]=0;P_VEL[65]=0;P_PROB[65]=0;
  P_NOTE[66]=-1;P_GATE[66]=0;P_VEL[66]=0;P_PROB[66]=0;
  P_NOTE[67]=77;P_GATE[67]=15;P_VEL[67]=115;P_PROB[67]=40;
  P_NOTE[68]=71;P_GATE[68]=10;P_VEL[68]=70;P_PROB[68]=100;
  P_ARR[0]=25;
  P_ARR[1]=0;
  P_ARR[2]=0;
  P_ARR[3]=0;
  P_ARR[4]=0;
  P_ARR[5]=15;
  P_ARR[6]=0;
  P_ARR[7]=16;
  P_ARR[8]=0;
  P_ARR[9]=40;
  P_ARR[10]=35;
  P_ARR[11]=0;
  P_ARR[12]=65;
  P_ARR[13]=0;
  P_ARR[14]=55;
  P_ARR[15]=15;
  P_ARR[16]=16;
  P_ARR[17]=0;
  P_ARR[18]=55;
  P_ARR[19]=60;
  P_ARR[20]=0;
  P_ARR[21]=100;
  P_ARR[22]=0;
  P_ARR[23]=50;
  P_ARR[24]=40;
  P_ARR[25]=16;
  P_ARR[26]=0;
  P_ARR[27]=70;
  P_ARR[28]=70;
  P_ARR[29]=15;
  P_ARR[30]=100;
  P_ARR[31]=18;
  P_ARR[32]=60;
  P_ARR[33]=55;
  P_ARR[34]=16;
  P_ARR[35]=0;
  P_ARR[36]=70;
  P_ARR[37]=75;
  P_ARR[38]=80;
  P_ARR[39]=100;
  P_ARR[40]=75;
  P_ARR[41]=35;
  P_ARR[42]=70;
  P_ARR[43]=12;
  P_ARR[44]=0;
  P_ARR[45]=85;
  P_ARR[46]=85;
  P_ARR[47]=100;
  P_ARR[48]=100;
  P_ARR[49]=100;
  P_ARR[50]=65;
  P_ARR[51]=95;
  P_ARR[52]=16;
  P_ARR[53]=12;
  P_ARR[54]=45;
  P_ARR[55]=70;
  P_ARR[56]=90;
  P_ARR[57]=100;
  P_ARR[58]=100;
  P_ARR[59]=10;
  P_ARR[60]=45;
  P_ARR[61]=16;
  P_ARR[62]=12;
  P_ARR[63]=25;
  P_ARR[64]=30;
  P_ARR[65]=0;
  P_ARR[66]=65;
  P_ARR[67]=0;
  P_ARR[68]=80;
  P_ARR[69]=15;
  P_ARR[70]=16;
  P_ARR[71]=0;
  // Prevent the legacy four engines from sounding over the three MIDI lanes.
  l=0;loop(4,slider(51+l*8)=0;l+=1;);
  // Avoid double-controlling the same CC74/CC71 via old default MOD lanes.
  slider90=0;slider104=0;
  slider17=16;slider10=100;slider1=1;sliderchange(-1);
  panic_request=1;reset_request=1;
);

function genre_preset(preset) local(i) (
  // Explicit user action only: preserving existing parameters until button is clicked.
  preset=iround(clamp(preset,0,7));
  M_CFG[1]=preset;M_CFG[0]=1;M_CFG[2]=1;M_CFG[3]=6;M_CFG[22]=1;
  slider10=95;slider17=16;slider1=1;sliderchange(slider10);sliderchange(slider17);
  // Genre gate and probability replace restrictive old Euclidean gates on preset load.
  i=0;loop(4,
    slider(57+i*8)=0;sliderchange(slider(57+i*8));
    slider(53+i*8)=100;sliderchange(slider(53+i*8));
    i+=1;
  );
  slider1=1;sliderchange(slider1);
  i=0;loop(4,slider(51+i*8)=1;sliderchange(slider(51+i*8));i+=1;);
  preset==1 ? (M_CFG[4]=1;M_CFG[5]=9;M_CFG[8]=4;M_CFG[11]=10;M_CFG[6]=2;) :
  preset==2 ? (M_CFG[4]=1;M_CFG[5]=0;M_CFG[8]=9;M_CFG[11]=2;M_CFG[6]=1;) :
  preset==3 ? (M_CFG[4]=7;M_CFG[5]=13;M_CFG[8]=0;M_CFG[11]=15;M_CFG[6]=2;) :
  preset==4 ? (M_CFG[4]=3;M_CFG[5]=9;M_CFG[8]=12;M_CFG[11]=8;M_CFG[6]=4;) :
  preset==5 ? (M_CFG[4]=2;M_CFG[5]=12;M_CFG[8]=10;M_CFG[11]=11;M_CFG[6]=4;M_CFG[3]=3;) :
  preset==6 ? (M_CFG[4]=1;M_CFG[5]=9;M_CFG[8]=0;M_CFG[11]=16;M_CFG[6]=2;) :
  preset==7 ? (M_CFG[4]=2;M_CFG[5]=12;M_CFG[8]=8;M_CFG[11]=15;M_CFG[6]=2;) :
                (M_CFG[4]=1;M_CFG[5]=0;M_CFG[8]=0;M_CFG[11]=0;M_CFG[6]=2;);
  // Bass, arp, melody, pad are assigned to MIDI channels 1..4 by existing defaults.
  reset_request=1;
);

function trigger_note(e,offs,event_t) local(st,step,hits,slots,eligible,lo,hi,vel,idx,base,tries,pitch,vslot,ch,bc,burstboost,prob,scale,degree,pressure,dur,rat,rr,k,last,src,swing) (
  base=51+e*8;
  step=ENGINE_STEP[e];
  ENGINE_STEP[e]=step+1;
  (M_CFG[0]>.5 && (M_CFG[0]<1.5 || M_CFG[0]>2.5 || rng()*100>=clamp(pv(8)*.50,0,65))) ? (
    music_step(e,offs,event_t,step);
  ) : (
  hits=iround(clamp(pv(base+6),0,16));
  slots=max(1,iround(pv(base+7)));
  eligible=hits>0 && ((step*hits)%slots)<min(hits,slots);
  prob=clamp(pv(10)*pv(base+2)/100,0,100);
  // Slow self-evolution without overwriting automatable host parameters.
  slider32>.5 ? prob*=.83+.34*(.5+.5*sin(run_samples/max(1,srate)*.029+e));
  audio_boost=slider30>.5 ? clamp(audio_env*pv(31)*2,0,40) : 0;
  eligible && rng()*100 < clamp(prob+audio_boost,0,100) ? (
    rng()*100 < pv(48)*.035 ? burst_events=8+floor(rng()*12);
    burstboost=burst_events>0;
    burst_events=max(0,burst_events-1);
    src=source_random(e);
    // Sequence memory, mutation and mutual attraction between the four engines.
    idx=floor(src*61);
    pv(2)>=3.5 && KEY_HIST[e*16+(step%16)]>=0 && rng()*100>pv(9) ? idx=KEY_HIST[e*16+(step%16)];
    rng()*100<pv(46) ? idx=swarm_next(e);
    slider22>.5 && incoming_note>=0 && clock_samples<feedback_until && rng()*100<pv(47) ? idx=clamp(incoming_note-iround(pv(5))+floor((rng()-.5)*8),0,60);
    idx=iround(clamp(30+(idx-30)*max(.08,pv(base+5)/100),0,60));
    scale=iround(pv(6));
    rng()*100<pv(34) ? scale=iround(pv(35));
    // Pitch limits and key probabilities. 61 tries guarantees bounded work.
    tries=0;pitch=-1;
    while(tries<61 && pitch<0) (
      degree=(idx+tries*7)%61;
      bc=iround(clamp(pv(5),0,67))+degree;
      (burstboost || note_allowed(bc,scale)) && rng()*100 < pv(195+degree) ? (pitch=bc;idx=degree;);
      tries+=1;
    );
    pitch>=0 ? (
      KEY_HIST[e*16+(step%16)]=idx;
      ENGINE_LAST[e]=idx;
      maxvoice=iround(clamp(pv(17),1,16));
      slider21>.5 ? maxvoice=min(maxvoice,15);
      voices>=maxvoice ? (
        victim=-1;soonest=1000000000000;k=0;
        loop(128,
          V_ON[k]>.5 && V_DUE[k]<soonest ? (victim=k;soonest=V_DUE[k];);
          k+=1;
        );
        victim>=0 ? release_voice(victim,offs);
      );
      vslot=find_voice();
      V_ON[vslot]>.5 ? release_voice(vslot,offs);
      ch=iround(pv(base+4))-1;
      slider21>.5 ? (ch=find_mpe_channel(); ch<0 ? ch=1;);
      lo=min(pv(15),pv(16));hi=max(pv(15),pv(16));
      vel=cc7(lo+rng()*(hi-lo));
      vel=cc7(vel+(rng()-.5)*pv(12)*.25);
      vel=cc7(vel*(.7+.3*(.5+.5*sin(run_samples/max(1,srate)*.25))*(pv(50)/100)));
      vel=max(1,vel);
      midi_bus=iround(pv(18))-1;
      slider23>.5 && rng()*100 < pv(24) ? midisend(offs,$xC0+ch,(iround(pv(49))+floor(rng()*128))%128);
      midisend(offs,$x90+ch,pitch,vel);
      V_ON[vslot]=1;V_PITCH[vslot]=pitch;V_CH[vslot]=ch;V_BUS[vslot]=midi_bus;V_ENG[vslot]=e;V_VEL[vslot]=vel;
      voices+=1;
      dur=max(12,pv(13)*pv(base+3)/100*(1+(rng()-.5)*2*pv(14)/100));
      V_DUE[vslot]=event_t+dur*srate/1000;
      last_pitch=pitch;last_velocity=vel;
      // Ratchets are real scheduled 2-4 retriggers instead of extra notes without offs.
      rng()*100 < pv(33) && dur>70 ? (
        rr=1+floor(rng()*3);rat=1;
        loop(rr,
          ratchet_next=(ratchet_next%64)+1;
          ratchet_count=max(ratchet_count,ratchet_next);
          RAT_ON[ratchet_next]=vslot;
          RAT_PITCH[ratchet_next]=pitch;
          RAT_AT[ratchet_next]=event_t+srate*dur/1000*rat/(rr+1);
          rat+=1;
        );
      );
    );
  );
  ); // end music/chaos branch
);
function mod_value(i,rate,shape,dt) local(p,w,phasev,newv) (
  p=MOD_PHASE[i]+dt*max(.01,rate)*2*$pi;
  p>=2*$pi ? (
    p-=floor(p/(2*$pi))*2*$pi;
    MOD_HOLD[i]=rng();
    MOD_LFO[i]=max(.1,1+(rng()-.5)*pv(9)/50);
  );
  MOD_PHASE[i]=p;
  shape==0 ? w=.5+.5*sin(p) :
  shape==1 ? w=.5+asin(sin(p))/$pi :
  shape==2 ? w=MOD_HOLD[i] :
  shape==3 ? w=.5+.5*cos(p) :
  shape==4 ? (MOD_WALK[i]=clamp(3.7+.295*pv(8)/100,3.6,3.999)*MOD_WALK[i]*(1-MOD_WALK[i]);w=MOD_WALK[i];) :
  (MOD_WALK[i]=clamp(MOD_WALK[i]+(rng()-.5)*.17,0,1);w=MOD_WALK[i];);
  clamp(w,0,1);
);
function send_mod(l,offs,dt) local(base,type,num,rawnum,a,b,val,n14,ch,busidx,j,k,n,found,pitch) (
  base=83+l*7;
  pv(base)>.5 ? (
    type=iround(pv(base+1));
    rawnum=iround(clamp(pv(base+2),0,16383));
    num=min(127,rawnum);
    a=pv(base+3); b=pv(base+4);
    val=clamp((a+(b-a)*mod_value(l,pv(base+5)*max(.1,MOD_LFO[l]),iround(pv(base+6)),dt))/127,0,1);
    MOD_PREV[l]=val;
    ch=iround(pv(19))-1;
    midi_bus=iround(pv(18))-1;
    n=cc7(val*127); n14=iround(val*16383);
    type==0 ? midisend(offs,$xB0+ch,num,n);
    type==1 ? ( // 14-bit CC: MSB controller must be 0..31
      num=min(31,num);
      midisend(offs,$xB0+ch,num,floor(n14/128));
      midisend(offs,$xB0+ch,num+32,n14%128);
    );
    type==2 || type==3 ? ( // member-channel expression when enabled
      slider21>.5 && slider45>.5 ? (
        k=0;
        loop(128,
          V_ON[k]>.5 ? (
            type==2 ? midisend(offs,$xE0+V_CH[k],n14%128,floor(n14/128)) : midisend(offs,$xD0+V_CH[k],n);
          );
          k+=1;
        );
      ) : (
        type==2 ? midisend(offs,$xE0+ch,n14%128,floor(n14/128)) : midisend(offs,$xD0+ch,n);
      );
    );
    type==4 ? ( // polyphonic aftertouch, limited to one active note per tick
      found=-1;k=0;
      while(k<128 && found<0) (
        V_ON[k]>.5 ? found=k;
        k+=1;
      );
      found>=0 ? midisend(offs,$xA0+V_CH[found],V_PITCH[found],n);
    );
    (type==5 || type==6) && slider40>.5 && (clock_samples+offs-MOD_SENT[l])>srate*.10 ? (
      MOD_SENT[l]=clock_samples+offs;
      type==5 ? (midisend(offs,$xB0+ch,101,floor(rawnum/128));midisend(offs,$xB0+ch,100,rawnum%128);) :
                 (midisend(offs,$xB0+ch,99,floor(rawnum/128));midisend(offs,$xB0+ch,98,rawnum%128););
      midisend(offs,$xB0+ch,6,floor(n14/128));
      midisend(offs,$xB0+ch,38,n14%128);
      // Null selectors to prevent unrelated data-entry events changing target.
      type==5 ? (midisend(offs,$xB0+ch,101,127);midisend(offs,$xB0+ch,100,127);) :
                 (midisend(offs,$xB0+ch,99,127);midisend(offs,$xB0+ch,98,127););
    );
  );
);
function bridge_publish() local(group,j) (
  group=iround(slider42)*1024;
  gmem[group]=314159;
  gmem[group+1]+=1;
  j=0;
  loop(16,
    gmem[group+2+j]=MOD_PREV[j];
    gmem[group+18+j]=pv(83+j*7)>.5 ? 1 : 0;
    gmem[group+34+j]=iround(pv(84+j*7));
    j+=1;
  );
  gmem[group+50]=engine_active;
);
function reset_engine() local(j) (
  rng_state=max(1,iround(slider4));
  run_samples=0;
  j=0;
  loop(4,
    CHAOS_X[j]=.17+.13*j+.0000001*(rng()*1000);
    LORENZ_X[j]=1+j*.13;LORENZ_Y[j]=.4+j*.05;LORENZ_Z[j]=8;
    ENGINE_NEXT[j]=clock_samples;ENGINE_STEP[j]=0;ENGINE_LAST[j]=30;
    j+=1;
  );
  j=0;
  loop(16,AGENT_POS[j]=rng()*60;AGENT_VEL[j]=rng()*4-2;j+=1;);
  j=0;
  loop(16,
    MOD_PHASE[j]=rng()*2*$pi;MOD_HOLD[j]=rng();MOD_LFO[j]=1;
    MOD_WALK[j]=.3+rng()*.4;MOD_PREV[j]=.5; MOD_SENT[j]=-1000000000000;
    j+=1;
  );
  burst_events=0;ratchet_count=0;ratchet_next=0;next_mod=clock_samples;last_bus=iround(slider18)-1;
  j=1;loop(64,RAT_AT[j]=1000000000000;j+=1;);
j=0;loop(24,M_PREVVOICE[j]=-999;j+=1;);
j=0;loop(64,CAN_ON[j]=0;j+=1;);
canon_cursor=0;canon_emitting=0;
j=0;loop(3,P_NEXT[j]=clock_samples;P_STEP[j]=0;j+=1;);
j=0;loop(15,P_LASTCC[j]=-999;j+=1;);
poly_prev_enabled=P_CTL[0]>.5;

);

// Ratchets and memory buffers remain within allocated blocks.
RAT_ON=6000;RAT_AT=6100;RAT_PITCH=6200;
clock_samples=0;last_srate=srate;engine_active=0;voices=0;
incoming_note=-1;incoming_vel=0;feedback_until=-1;audio_env=0;morph_phase=0;
ui_poly_lane=0;ui_poly_step=0;ui_poly_bank=0;ui_poly_phase=0;ui_poly_drag=-1;
ui_tab=0;ui_mod_page=0;ui_prev_down=0;ui_drag=0;ui_custom_drag=-1;ui_step_drag=-1;ui_array_drag=-1;ui_ext_drag=-1;ui_poly_drag=-1;ui_edit_engine=0;ui_edit_step=0;ui_scene_selected=0;ui_speed_drag=0;
panic_request=0;sysex_request=0;reset_request=0;
ui_version=1;
reset_engine();
i=0;loop(128,V_ON[i]=0;i+=1;);
i=0;loop(64,KEY_HIST[i]=-1;i+=1;);
i=0;loop(256,M_MOTIF[i]=-999;i+=1;);
// Transport stop should release voices and restart the motif phase cleanly.

@serialize
// Snapshots & their validity are stored in the .RPP alongside JSFX sliders.
file_mem(0,SCENE_BASE,2048);
file_mem(0,SCENE_VALID,8);
file_mem(0,M_CFG,64);
file_mem(0,M_SCENE,512);
// Sequencer patterns, individual scene snapshots and evolving melody memory.
file_mem(0,M_SEQ,128);
file_mem(0,M_GATE,128);
file_mem(0,M_VEL,128);
file_mem(0,M_CASCADE,8);
file_mem(0,M_SEQSC,1024);
file_mem(0,M_GATESC,1024);
file_mem(0,M_VELSC,1024);
file_mem(0,M_CASC_SC,64);
file_mem(0,M_MOTIF,256);
file_mem(0,M_MOTSC,2048);
file_mem(0,M_EXT,32);
file_mem(0,M_EXTSC,256);
file_mem(0,P_CTL,64);
file_mem(0,P_NOTE,96);file_mem(0,P_GATE,96);file_mem(0,P_VEL,96);file_mem(0,P_PROB,96);
file_mem(0,P_ARR,72);
file_mem(0,P_SCTL,512);file_mem(0,P_SNOTE,768);file_mem(0,P_SGATE,768);
file_mem(0,P_SVEL,768);file_mem(0,P_SPROB,768);file_mem(0,P_SARR,576);

@slider
// All 255 controls are hidden from the default REAPER JSFX panel.
// Values are still host parameters; the custom @gfx is the only editor.

@sample
// Optional sidechain/audio response. Audio itself is passed through unchanged.
audio_env=max(abs(spl0),abs(spl1))*.0004+audio_env*.9996;

@block
// Buffer-based MIDI input: keeps SysEx intact when input forwarding enabled.
midi_bus=0;
while ((recvlen=midirecv_buf(recv_off,MIDI_TMP,1024))>0) (
  rec_status=MIDI_TMP[0];
  rec_type=rec_status&$xF0;
  rec_type==$x90 && recvlen>=3 && MIDI_TMP[2]>0 ? (
    incoming_note=MIDI_TMP[1];incoming_vel=MIDI_TMP[2];feedback_until=clock_samples+srate*2;
    slider43>.5 ? ( // a live note can cause a note burst via the next engine event
      e=0;
      loop(4,ENGINE_NEXT[e]=min(ENGINE_NEXT[e],clock_samples+recv_off);e+=1;);
    );
  );
  slider20>.5 ? midisend_buf(recv_off,MIDI_TMP,recvlen);
);

wanted=slider1>.5 && (slider3>.5 || (play_state&1));
(!wanted || srate!=last_srate || panic_request>.5) ? (
  engine_active>.5 || panic_request>.5 ? panic(0);
  engine_active=0;
  last_srate=srate;
  panic_request=0;
);
reset_request>.5 ? (panic(0);reset_engine();engine_active=0;reset_request=0;);
sysex_request>.5 ? (
  slider41>.5 ? (
    MIDI_TMP[0]=$xF0;MIDI_TMP[1]=$x7E;MIDI_TMP[2]=$x7F;MIDI_TMP[3]=$x09;
    MIDI_TMP[4]=$x01;MIDI_TMP[5]=$xF7;
    midi_bus=iround(slider18)-1;
    midisend_buf(0,MIDI_TMP,6);
  );
  sysex_request=0;
);
wanted ? (
  ((P_CTL[0]>.5) != (poly_prev_enabled>.5)) ? (
    poly_prev_enabled=P_CTL[0]>.5;
    e=0;loop(3,P_NEXT[e]=clock_samples;P_STEP[e]=0;e+=1;);
  );
  !engine_active ? (
    reset_engine();engine_active=1;
  );
  // Scene A -> B morph, with slow automatic motion when autopilot is enabled.
  slider32>.5 ? (
    morph_phase=.5+.5*sin(run_samples/max(1,srate)*.05);
  ) : (
    morph_phase=clamp(slider44/100,0,1);
  );
  blockend=clock_samples+samplesblock;
  iterations=0;again=1;
  while(iterations<384 && again) (
    evt=next_mod;event_kind=2;event_id=0;
    e=0;
    loop(4,
      slider(51+e*8)>.5 && ENGINE_NEXT[e]<=evt ? (
        evt=ENGINE_NEXT[e];event_kind=1;event_id=e;
      );
      e+=1;
    );
    j=0;
    loop(3,
      P_CTL[0]>.5 && P_CTL[20+j]>.5 && P_NEXT[j]<=evt ? (
        evt=P_NEXT[j];event_kind=6;event_id=j;
      );j+=1;
    );
    j=0;
    loop(128,
      V_ON[j]>.5 && V_DUE[j]<=evt ? (
        evt=V_DUE[j];event_kind=3;event_id=j;
      );
      j+=1;
    );
    j=1;
    while(j<=ratchet_count) (
      RAT_AT[j]<=evt ? (evt=RAT_AT[j];event_kind=4;event_id=j;);
      j+=1;
    );
    j=0;
    loop(64,
      CAN_ON[j]>.5 && CAN_AT[j]<=evt ? (evt=CAN_AT[j];event_kind=5;event_id=j;);
      j+=1;
    );
    evt<blockend ? (
      offs=iround(clamp(evt-clock_samples,0,samplesblock-1));
      event_kind==3 ? release_voice(event_id,offs) :
      event_kind==6 ? poly_step(event_id,offs,evt) :
      event_kind==5 ? (
        // Bounded canon echo from the source note; guard against endless re-echo.
        CAN_ON[event_id]=0;
        canon_emitting=1;
        music_emit(CAN_ENG[event_id],CAN_PITCH[event_id],offs,evt,CAN_DUR[event_id],CAN_ACC[event_id]);
        canon_emitting=0;
      ) :
      event_kind==4 ? (
        vv=RAT_ON[event_id];
        V_ON[vv]>.5 && V_PITCH[vv]==RAT_PITCH[event_id] && V_DUE[vv]>evt+srate*.012 ? (
          midi_bus=V_BUS[vv];
          midisend(offs,$x80+V_CH[vv],V_PITCH[vv],0);
          midisend(offs,$x90+V_CH[vv],V_PITCH[vv],V_VEL[vv]);
        );
        RAT_AT[event_id]=1000000000000;
      ) :
      event_kind==1 ? (
        e=event_id;
        base=51+e*8;
        bpm=max(25,tempo);
        spacing=music_spacing(e);
        swing=slider39>.5 ? 1 : (ENGINE_STEP[e]%2) ? (1+pv(11)/200) : (1-pv(11)/200);
        spacing*=swing;
        slider39<.5 ? spacing*=clamp(1+(rng()-.5)*pv(12)/130,.4,1.6);
        ENGINE_NEXT[e]=evt+max(srate*.003,spacing);
        slider(51+e*8)>.5 ? trigger_note(e,offs,evt);
      ) : (
        // Frequencies & shapes are independent for all 16 lanes.
        dt=1/max(5,pv(25));
        k=0;
        loop(16,send_mod(k,offs,dt);k+=1;);
        next_mod=evt+max(srate/60,srate/max(5,pv(25)));
        slider26>.5 ? (
          bend=iround(clamp(8192+(MOD_PREV[1]*2-1)*8191*pv(27)/100,0,16383));
          midi_bus=iround(pv(18))-1;
          midisend(offs,$xE0+iround(pv(19))-1,bend%128,floor(bend/128));
        );
        slider28>.5 ? (
          midi_bus=iround(pv(18))-1;
          midisend(offs,$xD0+iround(pv(19))-1,cc7(MOD_PREV[2]*127));
        );
        slider29>.5 && voices>0 ? (
          victim=-1;k=0;
          while(k<128 && victim<0) (V_ON[k]>.5 ? victim=k; k+=1;);
          victim>=0 ? (
            midi_bus=V_BUS[victim];
            midisend(offs,$xA0+V_CH[victim],V_PITCH[victim],cc7(MOD_PREV[3]*127));
          );
        );
        poly_cc_tick(offs);
        bridge_publish();
      );
      iterations+=1;
    ) : again=0;
  );
  run_samples+=samplesblock;
);
clock_samples+=samplesblock;


@gfx 1120 840
// LautFunk visuals match the FartSynth 61 palette. All host sliders are hidden.
function ui_set_accent(active) (
  active ? gfx_set(.18,.91,.77,1) : gfx_set(.50,.62,.71,1);
);
function ui_panel(x,y,w,h) (
  gfx_set(.071,.101,.145,1);gfx_rect(x,y,w,h);
  gfx_set(.12,.18,.235,1);gfx_rect(x,y,w,1);
);
function ui_text(x,y,t) (
  gfx_x=x;gfx_y=y;gfx_drawstr(t);
);
function ui_button(x,y,w,h,t,selected) local(hit) (
  hit=mouse_x>=x && mouse_x<x+w && mouse_y>=y && mouse_y<y+h;
  selected ? gfx_set(.125,.40,.42,1) :
  hit ? gfx_set(.13,.20,.27,1) : gfx_set(.078,.125,.17,1);
  gfx_rect(x,y,w,h);
  selected ? gfx_set(.18,.91,.77,1) : gfx_set(.52,.68,.77,1);
  gfx_rect(x,y,3,h);
  gfx_setfont(2,"Arial",12);
  gfx_set(.89,.95,.96,1);ui_text(x+10,y+9,t);
  hit && ui_click;
);
function ui_knob(idx,x,y,w,t) local(val,lo,hi,st,frac,nv,hit,lane,mode) (
  lo=PMIN[idx]; hi=PMAX[idx];st=PSTEP[idx];
  idx>=85 && idx<=190 && ((idx-85)%7)==0 ? (
    lane=floor((idx-85)/7);
    mode=slider(84+lane*7);
    mode<4.5 || mode>6.5 ? hi=127;
  );
  val=slider(idx); frac=clamp((val-lo)/max(.001,hi-lo),0,1);
  gfx_setfont(2,"Arial",12);gfx_set(.74,.82,.88,1);ui_text(x,y,t);
  gfx_set(.18,.91,.77,1);
  gfx_setfont(3,"Arial",11);
  st<1 ? sprintf(#val,"%.2f",val) : sprintf(#val,"%d",iround(val));
  gfx_x=x+w-56;gfx_y=y;gfx_drawstr(#val);
  gfx_set(.11,.16,.21,1);gfx_rect(x,y+23,w,10);
  gfx_set(.18,.77,.71,1);gfx_rect(x,y+23,max(1,w*frac),10);
  gfx_set(.95,.98,.99,1);gfx_rect(x+frac*w-2,y+21,4,14);
  hit=(mouse_x>=x && mouse_x<=x+w && mouse_y>=y+12 && mouse_y<=y+39);
  ui_down && ((ui_click && hit) || ui_drag==idx) ? (
    ui_drag=idx;
    nv=lo+clamp((mouse_x-x)/max(1,w),0,1)*(hi-lo);
    nv=clamp(floor(nv/st+.5)*st,lo,hi);
    nv!=val ? (
      slider(idx)=nv;
      sliderchange(slider(idx));
      slider_automate(slider(idx));
    );
  );
);

function ui_custom(idx,x,y,w,t,minimum,maximum,inc) local(val,frac,nv,hit) (
  val=M_CFG[idx];frac=clamp((val-minimum)/max(.001,maximum-minimum),0,1);
  gfx_setfont(2,"Arial",12);gfx_set(.75,.84,.90,1);ui_text(x,y,t);
  gfx_setfont(3,"Arial",11);gfx_set(.20,.92,.77,1);
  sprintf(#cv,"%d",iround(val));gfx_x=x+w-42;gfx_y=y;gfx_drawstr(#cv);
  gfx_set(.11,.17,.23,1);gfx_rect(x,y+23,w,9);
  gfx_set(.18,.76,.70,1);gfx_rect(x,y+23,max(1,w*frac),9);
  gfx_set(.93,.98,.98,1);gfx_rect(x+frac*w-2,y+21,4,13);
  hit=(mouse_x>=x&&mouse_x<=x+w&&mouse_y>=y+13&&mouse_y<=y+37);
  ui_down && ((ui_click&&hit)||ui_custom_drag==idx) ? (
    ui_custom_drag=idx;
    nv=minimum+clamp((mouse_x-x)/max(1,w),0,1)*(maximum-minimum);
    nv=clamp(floor(nv/inc+.5)*inc,minimum,maximum);
    M_CFG[idx]=nv;
  );
);
function ui_cbutton(x,y,w,h,t,idx,n) (
  ui_button(x,y,w,h,t,M_CFG[idx]==n) ? M_CFG[idx]=n;
);

// PERSISTENT CLOCK WIDGET: visible on every editor tab, no standard JSFX controls.
function ui_speed_rate_name(n) (
  n=iround(clamp(n,0,14));
  n==0 ? #speed_rate="4 BARS";
  n==1 ? #speed_rate="2 BARS";
  n==2 ? #speed_rate="1 BAR";
  n==3 ? #speed_rate="1/2";
  n==4 ? #speed_rate="1/4";
  n==5 ? #speed_rate="1/8";
  n==6 ? #speed_rate="1/16";
  n==7 ? #speed_rate="1/32";
  n==8 ? #speed_rate="1/64";
  n==9 ? #speed_rate="1/8 T";
  n==10 ? #speed_rate="1/16 T";
  n==11 ? #speed_rate="1/32 T";
  n==12 ? #speed_rate="1/8 D";
  n==13 ? #speed_rate="1/16 D";
  n==14 ? #speed_rate="1/32 D";
);
function ui_speed_nudge(direction) local(v) (
  M_CFG[2]>.5 ? (
    M_CFG[3]=clamp(iround(M_CFG[3])+direction,0,14);
  ) : (
    direction>0 ? v=slider256/1.25 : v=slider256*1.25;
    v=clamp(floor(v/.005+.5)*.005,.05,8);
    abs(v-slider256)>.00001 ? (
      slider256=v;
      sliderchange(slider256);
      slider_automate(slider256);
    );
  );
);
function ui_speed_meter(x,y,w) local(v,f,hit,newv,sync) (
  sync=M_CFG[2]>.5;
  sync ? (
    v=iround(clamp(M_CFG[3],0,14));
    f=v/14;
    ui_speed_rate_name(v);
  ) : (
    v=clamp(slider256,.05,8);
    f=clamp(log(v/.05)/log(160),0,1);
    sprintf(#speed_rate,"%.3f s",v);
  );
  gfx_set(.062,.12,.16,1);gfx_rect(x,y,w,29);
  gfx_set(.18,.38,.39,1);gfx_rect(x,y,w,1);
  gfx_setfont(3,"Arial",15);gfx_set(.30,.96,.81,1);
  gfx_x=x+12;gfx_y=y+2;gfx_drawstr(#speed_rate);
  gfx_set(.13,.24,.29,1);gfx_rect(x+5,y+24,w-10,3);
  gfx_set(.18,.91,.77,1);gfx_rect(x+5,y+24,max(2,(w-10)*f),3);
  hit=mouse_x>=x&&mouse_x<x+w&&mouse_y>=y&&mouse_y<y+29;
  ui_down && ((ui_click&&hit)||ui_speed_drag>.5) ? (
    ui_speed_drag=1;
    newv=clamp((mouse_x-(x+5))/max(1,w-10),0,1);
    sync ? (
      M_CFG[3]=iround(14*newv);
    ) : (
      newv=clamp(floor((.05*exp(newv*log(160)))/.005+.5)*.005,.05,8);
      abs(newv-slider256)>.00001 ? (
        slider256=newv;
        sliderchange(slider256);
        slider_automate(slider256);
      );
    );
  );
);

// Independent step editing using direct pixel-position sliders.
function ui_step_control(x,y,w,t,typ,lo,hi,inc) local(idx,val,frac,hit,nv) (
  idx=ui_edit_engine*32+ui_edit_step;
  val=typ==0 ? M_SEQ[idx] : typ==1 ? M_GATE[idx] : M_VEL[idx];
  gfx_setfont(2,"Arial",11);gfx_set(.75,.85,.90,1);ui_text(x,y,t);
  sprintf(#stepv,"%d",iround(val));gfx_x=x+w-38;gfx_y=y;gfx_drawstr(#stepv);
  frac=clamp((val-lo)/max(1,hi-lo),0,1);
  gfx_set(.08,.16,.20,1);gfx_rect(x,y+22,w,9);
  gfx_set(.16,.80,.71,1);gfx_rect(x,y+22,max(1,w*frac),9);
  hit=mouse_x>=x&&mouse_x<=x+w&&mouse_y>=y+16&&mouse_y<=y+36;
  ui_down && ((ui_click&&hit) || ui_step_drag==typ) ? (
    ui_step_drag=typ;
    nv=lo+floor(clamp((mouse_x-x)/max(1,w),0,1)*(hi-lo)/inc+.5)*inc;
    nv=clamp(nv,lo,hi);
    typ==0 ? M_SEQ[idx]=nv : typ==1 ? M_GATE[idx]=nv : M_VEL[idx]=nv;
  );
);
function ui_array_knob(addr,idx,x,y,w,t,lo,hi,inc) local(v,frac,hit,nv) (
  v=addr[idx];frac=clamp((v-lo)/max(1,hi-lo),0,1);
  gfx_setfont(2,"Arial",12);gfx_set(.74,.84,.90,1);ui_text(x,y,t);
  sprintf(#arrv,"%d",iround(v));gfx_x=x+w-40;gfx_y=y;gfx_drawstr(#arrv);
  gfx_set(.09,.16,.21,1);gfx_rect(x,y+23,w,9);
  gfx_set(.17,.8,.72,1);gfx_rect(x,y+23,max(1,frac*w),9);
  hit=mouse_x>=x&&mouse_x<x+w&&mouse_y>=y+15&&mouse_y<y+37;
  ui_down && ((ui_click&&hit)||ui_array_drag==idx) ? (
    ui_array_drag=idx;
    nv=lo+floor(clamp((mouse_x-x)/max(1,w),0,1)*(hi-lo)/inc+.5)*inc;
    addr[idx]=clamp(nv,lo,hi);
  );
);
function ui_ext(idx,x,y,w,t,lo,hi,inc) local(v,frac,hit,nv) (
  v=M_EXT[idx];frac=clamp((v-lo)/max(1,hi-lo),0,1);
  gfx_setfont(2,"Arial",12);gfx_set(.70,.85,.88,1);ui_text(x,y,t);
  sprintf(#ev,"%d",iround(v));gfx_x=x+w-42;gfx_y=y;gfx_drawstr(#ev);
  gfx_set(.10,.16,.22,1);gfx_rect(x,y+23,w,9);
  gfx_set(.17,.81,.70,1);gfx_rect(x,y+23,max(1,w*frac),9);
  hit=mouse_x>=x&&mouse_x<=x+w&&mouse_y>=y+15&&mouse_y<=y+36;
  ui_down && ((ui_click&&hit)||ui_ext_drag==idx) ? (
    ui_ext_drag=idx;
    nv=lo+floor(clamp((mouse_x-x)/max(1,w),0,1)*(hi-lo)/inc+.5)*inc;
    M_EXT[idx]=clamp(nv,lo,hi);
  );
);

function ui_polyval(addr,idx,x,y,w,t,lo,hi,inc,identity) local(v,frac,hit,nv) (
  v=addr[idx];frac=clamp((v-lo)/max(1,hi-lo),0,1);
  gfx_setfont(2,"Arial",11);gfx_set(.69,.84,.89,1);ui_text(x,y,t);
  gfx_set(.18,.90,.77,1);sprintf(#polyvalue,"%d",iround(v));gfx_x=x+w-35;gfx_y=y;gfx_drawstr(#polyvalue);
  gfx_set(.09,.16,.22,1);gfx_rect(x,y+21,w,9);
  gfx_set(.14,.75,.67,1);gfx_rect(x,y+21,max(1,w*frac),9);
  hit=(mouse_x>=x&&mouse_x<x+w&&mouse_y>=y+13&&mouse_y<y+37);
  ui_down && ((ui_click&&hit)||ui_poly_drag==identity) ? (
    ui_poly_drag=identity;
    nv=lo+floor(clamp((mouse_x-x)/max(1,w),0,1)*(hi-lo)/inc+.5)*inc;
    addr[idx]=clamp(nv,lo,hi);
  );
);
function ui_polybutton(x,y,w,h,t,idx,n) (
  ui_button(x,y,w,h,t,P_CTL[idx]==n) ? P_CTL[idx]=n;
);

function open_preset(id) (
  // Change only when the user clicks. Leaves global MIDI and host routing untouched.
  M_CFG[0]=3; M_CFG[22]=0;M_CFG[44]=1;M_CFG[45]=1;
  id==0 ? (
    M_EXT[0]=4;M_EXT[1]=1;M_EXT[2]=0;M_EXT[4]=1;
    M_EXT[8]=0;M_EXT[10]=1;M_EXT[12]=1;M_EXT[15]=0;
    M_CFG[4]=3;M_CFG[5]=9;M_CFG[3]=6;M_CFG[13]=1;
  ) : id==1 ? (
    M_EXT[0]=5;M_EXT[1]=1;M_EXT[2]=1;M_EXT[3]=30;
    M_EXT[4]=0;M_EXT[8]=0;M_EXT[10]=1;M_EXT[12]=1;M_EXT[15]=0;
    M_CFG[4]=3;M_CFG[5]=9;M_CFG[3]=6;
  ) : id==2 ? (
    M_EXT[0]=3;M_EXT[1]=2;M_EXT[2]=0;M_EXT[4]=0;
    M_EXT[8]=1;M_EXT[9]=8;M_EXT[10]=0;M_EXT[12]=0;M_EXT[15]=0;
    M_CFG[4]=2;M_CFG[5]=9;M_CFG[3]=3;
  ) : (
    M_EXT[0]=1;M_EXT[1]=3;M_EXT[2]=0;M_EXT[4]=0;
    M_EXT[8]=1;M_EXT[10]=1;M_EXT[12]=1;M_EXT[15]=1;
    M_CFG[4]=1;M_CFG[5]=9;M_CFG[3]=6;
  );
  reset_request=1;
);
function draw_keys(x,y,w,white_h) local(n,pc,black,whites,ww,xx,active,j,idx) (
  ww=w/36;
  n=0;whites=0;
  while(n<61) (
    pc=(iround(slider5)+n)%12;
    black=(pc==1||pc==3||pc==6||pc==8||pc==10);
    !black ? (
      xx=x+whites*ww;
      active=0;j=0;
      loop(128, V_ON[j]>.5 && V_PITCH[j]==iround(slider5)+n ? active=1;j+=1;);
      active ? gfx_set(.18,.91,.77,1) : gfx_set(.84,.88,.9,1);
      gfx_rect(xx,y,ww-1,white_h);
      gfx_set(.12,.31,.36,1);gfx_rect(xx,y+white_h-5,ww-1,5);
      whites+=1;
    );
    n+=1;
  );
  n=0;whites=0;
  while(n<61) (
    pc=(iround(slider5)+n)%12;
    black=(pc==1||pc==3||pc==6||pc==8||pc==10);
    black ? (
      xx=x+(whites-.34)*ww;
      active=0;j=0;
      loop(128,V_ON[j]>.5 && V_PITCH[j]==iround(slider5)+n ? active=1;j+=1;);
      active ? gfx_set(.94,.35,.63,1) : gfx_set(.027,.048,.078,1);
      gfx_rect(xx,y,ww*.67,white_h*.62);
      gfx_set(.13,.23,.29,1);gfx_rect(xx,y+white_h*.62-4,ww*.67,4);
    ) : whites+=1;
    n+=1;
  );
);

ui_down=mouse_cap&1;
ui_click=ui_down && !ui_prev_down;
!ui_down && ui_drag>0 ? (slider_automate(slider(ui_drag),1);ui_drag=0;);
!ui_down ? (
   ui_speed_drag>.5 ? (M_CFG[2]<.5 ? slider_automate(slider256,1);ui_speed_drag=0;);
   (ui_step_drag>=0 || ui_array_drag>=0 || ui_ext_drag>=0 || ui_poly_drag>=0) ? sliderchange(-1);
   ui_custom_drag=-1;ui_step_drag=-1;ui_array_drag=-1;ui_ext_drag=-1;ui_poly_drag=-1;
);
gfx_set(.025,.034,.054,1);gfx_rect(0,0,gfx_w,gfx_h);
// Header
ui_set_accent(1);gfx_setfont(1,"Arial",23);
ui_text(22,15,"LautFunk  /  MIDI CHAOS ENGINE 61");
gfx_setfont(2,"Arial",11);gfx_set(.59,.71,.79,1);
ui_text(24,48,"POLYTRANCE  /  4 ENGINES  /  3 POLY TRACKS");
// Always-on global speed strip. SYNC/SEC, exact division, speed nudges and direct edit.
speed_x=gfx_w-665;
ui_panel(speed_x,7,385,60);
gfx_set(.18,.91,.77,1);gfx_rect(speed_x,7,4,60);
gfx_setfont(2,"Arial",12);gfx_set(.27,.96,.82,1);
ui_text(speed_x+12,13,"GLOBAL NOTE SPEED");
gfx_setfont(2,"Arial",11);gfx_set(.60,.75,.82,1);
sprintf(#speed_bpm,"%.0f BPM",max(1,tempo));
ui_text(speed_x+295,14,#speed_bpm);
ui_button(speed_x+12,32,54,29,"SYNC",M_CFG[2]>.5) ? M_CFG[2]=1;
ui_button(speed_x+70,32,48,29,"SEC",M_CFG[2]<.5) ? M_CFG[2]=0;
ui_button(speed_x+122,32,26,29,"-",0) ? ui_speed_nudge(-1);
ui_speed_meter(speed_x+152,32,140);
ui_button(speed_x+296,32,26,29,"+",0) ? ui_speed_nudge(1);
ui_button(speed_x+326,32,48,29,"EDIT",ui_tab==6) ? ui_tab=6;
ui_button(gfx_w-274,15,91,31,slider1>.5?"RUNNING":"STOPPED",slider1>.5) ? (
  slider1=1-slider1;sliderchange(slider1);slider_automate(slider1);
);
ui_button(gfx_w-174,15,73,31,"RESEED",0) ? reset_request=1;
ui_button(gfx_w-93,15,74,31,"PANIC",0) ? (
  panic_request=1;slider1=0;sliderchange(slider1);slider_automate(slider1);
);

// Navigation (14 compact buttons, same dark LautFunk editor; no standard sliders).
nav_w=(gfx_w-48)/14;
ui_button(24,78,nav_w-4,37,"HOME",ui_tab==0) ? ui_tab=0;
ui_button(24+nav_w,78,nav_w-4,37,"ENGINES",ui_tab==1) ? ui_tab=1;
ui_button(24+2*nav_w,78,nav_w-4,37,"MODS",ui_tab==2) ? ui_tab=2;
ui_button(24+3*nav_w,78,nav_w-4,37,"KEYS",ui_tab==3) ? ui_tab=3;
ui_button(24+4*nav_w,78,nav_w-4,37,"ROUTING",ui_tab==4) ? ui_tab=4;
ui_button(24+5*nav_w,78,nav_w-4,37,"SCENES",ui_tab==5) ? ui_tab=5;
ui_button(24+6*nav_w,78,nav_w-4,37,"SPEED",ui_tab==6) ? ui_tab=6;
ui_button(24+7*nav_w,78,nav_w-4,37,"MUSIC",ui_tab==7) ? ui_tab=7;
ui_button(24+8*nav_w,78,nav_w-4,37,"HYPNO",ui_tab==8) ? ui_tab=8;
ui_button(24+9*nav_w,78,nav_w-4,37,"STEPS",ui_tab==9) ? ui_tab=9;
ui_button(24+10*nav_w,78,nav_w-4,37,"CASCADE",ui_tab==10) ? ui_tab=10;
ui_button(24+11*nav_w,78,nav_w-4,37,"SUSPENSE",ui_tab==11) ? ui_tab=11;
ui_button(24+12*nav_w,78,nav_w-4,37,"POLY",ui_tab==12) ? ui_tab=12;
ui_button(24+13*nav_w,78,nav_w-4,37,"FLOW",ui_tab==13) ? ui_tab=13;

