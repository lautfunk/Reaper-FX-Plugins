  ui_text(46,448,#polyedit);
  ui_polyval(P_NOTE,lane_pos,45,476,224,"NOTE -1=REST / 0..127",-1,127,1,100);
  ui_polyval(P_GATE,lane_pos,298,476,224,"GATE 0..100 %",0,100,1,101);
  ui_polyval(P_VEL,lane_pos,550,476,224,"VELOCITY 0..127",0,127,1,102);
  ui_polyval(P_PROB,lane_pos,803,476,224,"PROBABILITY %",0,100,1,103);
  ui_polyval(P_CTL,16+ui_poly_lane,45,562,224,"TRACK STEPS",1,32,1,104);
  ui_polyval(P_CTL,24+ui_poly_lane,298,562,224,"MIDI CHANNEL",1,16,1,105);
  ui_polyval(P_CTL,32+ui_poly_lane,550,562,224,"GATE SCALE %",10,150,1,106);
  ui_polyval(P_CTL,36+ui_poly_lane,803,562,224,"TRANSPOSE -24..24",-24,24,1,107);
  ui_button(46,640,160,32,"REST / NOTE",0) ? (P_NOTE[lane_pos]<0 ? P_NOTE[lane_pos]=40 : P_NOTE[lane_pos]=-1;);
  ui_button(225,640,160,32,"OCTAVE -",0) ? P_NOTE[lane_pos]=clamp(P_NOTE[lane_pos]-12,0,127);
  ui_button(400,640,160,32,"OCTAVE +",0) ? P_NOTE[lane_pos]=clamp(P_NOTE[lane_pos]+12,0,127);
  gfx_setfont(2,"Arial",11);gfx_set(.56,.69,.78,1);
  ui_text(582,648,"MIDI note labels depend on REAPER octave settings.");
  ui_polyval(P_CTL,44,45,677,188,"CC CUTOFF",0,127,1,130);
  ui_polyval(P_CTL,45,250,677,188,"CC RESONANCE",0,127,1,131);
  ui_polyval(P_CTL,46,455,677,188,"CC DECAY",0,127,1,132);
