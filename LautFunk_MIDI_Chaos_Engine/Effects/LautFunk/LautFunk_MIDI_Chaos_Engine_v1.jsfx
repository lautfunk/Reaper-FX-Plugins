    param==34 ? #lbl="Scale morph";param==46 ? #lbl="Swarm";param==47 ? #lbl="Feedback %";
    param==48 ? #lbl="Burst chance";param==50 ? #lbl="Vel. morph";param==22 ? #lbl="Input influence";
