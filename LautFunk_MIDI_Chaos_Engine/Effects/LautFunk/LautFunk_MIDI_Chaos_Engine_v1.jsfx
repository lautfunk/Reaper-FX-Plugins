  P_ARR[70]=16;
  P_ARR[71]=0;
);

function rng() (
  rng_state=(rng_state*16807)%2147483647;
  rng_state/2147483647;
);
function clamp(v,a,b) ( max(a,min(b,v)); );
function iround(x) (floor(x+.5));
function cc7(x) (iround(clamp(x,0,127)););
function pv(n) local(a,b,t) (
  (n>3 && n!=36 && n!=37 && n!=38 && n!=42 && slider36>.5 &&
    SCENE_VALID[iround(slider37)-1]>.5 && SCENE_VALID[iround(slider38)-1]>.5) ? (
    a=SCENE_BASE+(iround(slider37)-1)*256+n;
    b=SCENE_BASE+(iround(slider38)-1)*256+n;
    t=clamp(morph_phase,0,1);
    a[0]*(1-t)+b[0]*t;
  ) : slider(n);
);
function note_allowed(n,scale) local(pc) (
  pc=(n-iround(pv(7))+120)%12;
  scale==0 ? 1 :
  scale==1 ? (pc==0||pc==3||pc==5||pc==7||pc==10) :
  scale==2 ? (pc==0||pc==2||pc==3||pc==5||pc==7||pc==8||pc==10) :
  scale==3 ? (pc==0||pc==2||pc==4||pc==5||pc==7||pc==9||pc==11) :
  scale==4 ? (pc==0||pc==1||pc==3||pc==5||pc==7||pc==8||pc==10) :
  scale==5 ? (pc==0||pc==2||pc==3||pc==5||pc==7||pc==9||pc==10) :
  scale==6 ? (pc==0||pc==2||pc==4||pc==6||pc==8||pc==10) :
              (pc==0||pc==2||pc==3||pc==5||pc==7||pc==8||pc==11);
);
function save_scene(n) local(k,pos) (
  pos=SCENE_BASE+n*256;
  k=1;
  loop(255, (pos+k)[0]=slider(k); k+=1; );
  SCENE_VALID[n]=1;
  k=0;loop(63,(M_SCENE+n*64+k)[0]=M_CFG[k];k+=1;);
  M_SCENE[n*64+63]=slider256;
  k=0;loop(31,M_EXTSC[n*32+k]=M_EXT[k];k+=1;);
  M_EXTSC[n*32+31]=1300;
  k=0;loop(63,P_SCTL[n*64+k]=P_CTL[k];k+=1;);
  P_SCTL[n*64+63]=1400;
  k=0;loop(96,
    P_SNOTE[n*96+k]=P_NOTE[k];P_SGATE[n*96+k]=P_GATE[k];
    P_SVEL[n*96+k]=P_VEL[k];P_SPROB[n*96+k]=P_PROB[k];k+=1;
  );
  k=0;loop(72,P_SARR[n*72+k]=P_ARR[k];k+=1;);
  k=0;loop(128,
    M_SEQSC[n*128+k]=M_SEQ[k];
    M_GATESC[n*128+k]=M_GATE[k];
    M_VELSC[n*128+k]=M_VEL[k];k+=1;
  );
  k=0;loop(8,M_CASC_SC[n*8+k]=M_CASCADE[k];k+=1;);
  k=0;loop(256,M_MOTSC[n*256+k]=M_MOTIF[k];k+=1;);
  sliderchange(-1);
);
function load_scene(n) local(k,pos) (
  SCENE_VALID[n]>.5 ? (
    pos=SCENE_BASE+n*256; k=1;
    loop(255,
      (k!=1 && k!=36 && k!=37 && k!=38 && k!=42) ? (
        slider(k)=(pos+k)[0];
        sliderchange(slider(k));
      );
      k+=1;
    );
    k=0;loop(63,M_CFG[k]=(M_SCENE+n*64+k)[0];k+=1;);
    slider256=max(.05,M_SCENE[n*64+63]);sliderchange(-1);
    M_EXTSC[n*32+31]==1300 ? (
      k=0;loop(31,M_EXT[k]=M_EXTSC[n*32+k];k+=1;);
    );
    P_SCTL[n*64+63]==1400 ? (
      k=0;loop(63,P_CTL[k]=P_SCTL[n*64+k];k+=1;);
      k=0;loop(96,
        P_NOTE[k]=P_SNOTE[n*96+k];P_GATE[k]=P_SGATE[n*96+k];
        P_VEL[k]=P_SVEL[n*96+k];P_PROB[k]=P_SPROB[n*96+k];k+=1;
      );
      k=0;loop(72,P_ARR[k]=P_SARR[n*72+k];k+=1;);
    );
    k=0;loop(128,
      M_SEQ[k]=M_SEQSC[n*128+k];
      M_GATE[k]=M_GATESC[n*128+k];
      M_VEL[k]=M_VELSC[n*128+k];k+=1;
    );
    k=0;loop(8,M_CASCADE[k]=M_CASC_SC[n*8+k];k+=1;);
    k=0;loop(256,M_MOTIF[k]=M_MOTSC[n*256+k];k+=1;);
    reset_request=1;
    sliderchange(-1);
  );
);
function panic(offs) local(i,j,oldbus) (
  i=0;
  loop(128,
    V_ON[i]>.5 ? (
      midi_bus=V_BUS[i];
      midisend(offs,$x80+V_CH[i],V_PITCH[i],0);
      V_ON[i]=0;
    );
    i+=1;
  );
  oldbus=last_bus;
  midi_bus=oldbus;
  j=0;
  loop(16,
    midisend(offs,$xB0+j,123,0);
    midisend(offs,$xB0+j,120,0);
    midisend(offs,$xE0+j,0,64);
    midisend(offs,$xD0+j,0);
    j+=1;
  );
  voices=0;
);
function release_voice(slot,offs) (
  V_ON[slot]>.5 ? (
    midi_bus=V_BUS[slot];
    midisend(offs,$x80+V_CH[slot],V_PITCH[slot],0);
    V_ON[slot]=0;
    voices=max(0,voices-1);
  );
);
function find_voice() local(j,choice,oldest) (
  choice=-1; oldest=1000000000000; j=0;
  loop(128,
    V_ON[j]<.5 && choice<0 ? choice=j;
    j+=1;
  );
  choice<0 ? (
    j=0;
    loop(128,
      V_DUE[j]<oldest ? (choice=j;oldest=V_DUE[j];);
      j+=1;
    );
  );
  choice;
);
function find_mpe_channel() local(c,k,busy,answer) (
  answer=-1; c=1;
  while(c<16 && answer<0) (
    busy=0; k=0;
    loop(128, V_ON[k]>.5 && V_CH[k]==c ? busy=1; k+=1; );
    !busy ? answer=c;
    c+=1;
  );
  answer;
);
function source_random(e) local(z,zz) (
  CHAOS_X[e]=clamp(3.7+.298*pv(8)/100,3.6,3.999)*CHAOS_X[e]*(1-CHAOS_X[e]);
  CHAOS_X[e]=clamp(CHAOS_X[e],.0001,.9999);
  // Bounded Lorenz flow, deterministic with custom seed.
  z=LORENZ_X[e];zz=LORENZ_Y[e];
  LORENZ_X[e]+= .007*10*(zz-z);
  LORENZ_Y[e]+= .007*(z*(28-LORENZ_Z[e])-zz);
  LORENZ_Z[e]+= .007*(z*zz-2.66666667*LORENZ_Z[e]);
  abs(LORENZ_X[e])>80 || abs(LORENZ_Y[e])>80 || abs(LORENZ_Z[e])>80 ? (
    LORENZ_X[e]=1+e*.1;LORENZ_Y[e]=.4;LORENZ_Z[e]=8;
  );
  pv(2)<.5 ? (.5*rng()+.5*CHAOS_X[e]) :
  pv(2)<1.5 ? rng() :
  pv(2)<2.5 ? CHAOS_X[e] :
  pv(2)<3.5 ? clamp(.5+LORENZ_X[e]/50,0,1) :
  rng() < pv(9)/100 ? rng() : CHAOS_X[e];
);
function swarm_next(e) local(a,left,right,goal,delta,move) (
  a=floor(rng()*16);
  left=AGENT_POS[(a+15)%16];
  right=AGENT_POS[(a+1)%16];
  goal=(left+right+ENGINE_LAST[(e+3)%4])/3;
  // Attraction & repulsion: each agent can follow or avoid its neighbors.
  delta=goal-AGENT_POS[a];
  move=(rng()<.76 ? delta : -delta)*pv(46)/100*.17;
  AGENT_VEL[a]=clamp(AGENT_VEL[a]*.63+move+(rng()-.5)*6,-10,10);
  AGENT_POS[a]=clamp(AGENT_POS[a]+AGENT_VEL[a],0,60);
  AGENT_POS[a];
);

// ========== LAUTFUNK MUSICAL INTELLIGENCE ==========
// Index meanings are documented in README. All values are serialized and scene-saved.
function sc_int(d,mode) local(oc,ix) (
  d=iround(d);mode=iround(clamp(mode,0,13));
  oc=floor(d/7);ix=d-oc*7;
  oc*12+M_SCALE[mode*7+ix];
);
function chord_root_degree(prog,ix,major) local(d) (
  ix=iround(ix)%8;
  prog=iround(prog);
  prog==0 ? d=(ix%4==0?0:ix%4==1?5:ix%4==2?2:6) :
  prog==1 ? d=(ix%4==0?0:ix%4==1?5:ix%4==2?3:4) :
  prog==2 ? d=(ix%4==0?0:ix%4==1?3:ix%4==2?6:2) :
  prog==3 ? d=(ix%4==0?0:ix%4==1?6:ix%4==2?5:6) :
  prog==4 ? d=(ix%4==0?0:ix%4==1?1:ix%4==2?0:6) :
  prog==5 ? d=(ix%4==0?0:ix%4==1?5:ix%4==2?1:6) :
  prog==6 ? d=(ix%4==0?0:ix%4==1?4:ix%4==2?5:3) :
  prog==7 ? d=(ix%4==0?5:ix%4==1?3:ix%4==2?0:4) :
  prog==8 ? d=(ix%4==0?0:ix%4==1?3:ix%4==2?0:4) :
  prog==9 ? d=0 :
  prog==10 ? d=((ix*5+iround(slider4))%7) :
  prog==11 ? d=iround(M_CFG[32+ix]) :
  prog==12 ? d=(ix%4==0?0:ix%4==1?3:ix%4==2?5:4) :
  prog==13 ? d=(ix%4==0?0:ix%4==1?1:ix%4==2?6:0) :
  prog==14 ? d=(ix%4==0?0:ix%4==1?4:ix%4==2?3:5) :
               d=(ix%4==0?0:ix%4==1?2:ix%4==2?6:4);
  clamp(d,0,6);
);
function chord_n(q) (
  q=iround(clamp(q,0,25));
  q==0 ? 4 : M_CHORDCOUNT[q];
);
function chord_int(q,t,degree,mode) (
  q=iround(clamp(q,0,25));
  q==0 ? (sc_int(degree+t*2,mode)-sc_int(degree,mode)) : M_CHORD[q*8+t];
);
function gdivision(which) (
  which=iround(clamp(which,0,14));
  which==0 ? 16 : which==1 ? 8 : which==2 ? 4 : which==3 ? 2 :
  which==4 ? 1 : which==5 ? .5 : which==6 ? .25 : which==7 ? .125 :
  which==8 ? .0625 : which==9 ? (1/3) : which==10 ? (1/6) :
  which==11 ? (1/12) : which==12 ? .75 : which==13 ? .375 : .1875;
);
// Rate-shift phases use the current REAPER timeline when transport is running.
function m_beat_at(at) (
  slider3<.5 && (play_state&1) ? beat_position+(at-clock_samples)/srate*max(20,tempo)/60 :
    (run_samples+max(0,at-clock_samples))/srate*max(20,tempo)/60;
);
function pattern_style(st,e) local(p,ans) (
  p=iround(M_CFG[24]);ans=1;
  p==1 ? ans=(st%2==0) :
  p==2 ? ans=((st*5)%13)<8 :
  p==3 ? ans=(st%4==2) :
  p==4 ? ans=(st%8==0||st%8==3||st%8==6) :
  p==5 ? ans=(st%8==0||st%8==6) :
  p==6 ? ans=(st%11==0||st%11==4||st%11==7) :
  p==7 ? ans=(st%16<4||st%16==8||st%16==12);
  ans;
);
function rhythmic_breath(at) local(b,cycles) (
  b=m_beat_at(at);cycles=max(1,M_CFG[62])*4;
  .5+.5*sin(2*$pi*b/cycles);
);
function cascade_degrees(at) local(b,i) (
  b=m_beat_at(at);
  i=floor(max(0,b)/(max(1,M_CFG[60])*4))%8;
  M_CASCADE[i];
);
function note_in_key(n,mode,key) local(o,k,pc,best,d,bestd,nn) (
  best=n;bestd=99;
  o=-2;
  loop(6,
    k=0;loop(7,
      nn=key+o*12+M_SCALE[iround(clamp(mode,0,13))*7+k];
      d=abs(nn-n);
      d<bestd ? (best=nn;bestd=d;);
      k+=1;
    );o+=1;
  );
  best;
);
// Open/thirdless voicings: suspensions, stacked fourths and power chords.
function open_count() (
  M_EXT[0]==3 ? 4 : M_EXT[0]==4 ? 3 : M_EXT[0]==5 ? 3 : 3;
);
function open_interval(i) (
  M_EXT[0]==1 ? (i==0?0:i==1?2:7) :
  M_EXT[0]==2 ? (i==0?0:i==1?5:7) :
  M_EXT[0]==3 ? (i*5) :
  M_EXT[0]==4 ? (i==0?0:i==1?7:12) :
  M_EXT[0]==5 ? (i==0?0:i==1?1:7) : 0;
);
// Anti-cadence avoids forced V-I: static root, two poles or limited modal wander.
function modal_degree(chordix,deg) (
  M_EXT[1]==1 ? 0 :
  M_EXT[1]==2 ? (chordix%4==2 ? 1 : 0) :
  M_EXT[1]==3 ? (chordix%4==0?0:chordix%4==1?3:chordix%4==2?1:5) : deg;
);
function morph_arp_mode(beat,pat) local(segment) (
  M_EXT[10]>.5 ? (
    segment=floor(max(0,beat)/(4*max(1,M_EXT[11])))%4;
    segment==0 ? 0 : segment==1 ? 2 : segment==2 ? 1 : 3;
  ) : pat;
);
function canon_interval() (
 M_EXT[17]<.5 ? 0 : M_EXT[17]<1.5 ? 7 : 12;
);
function canon_delay_samples() (
 // One sixteenth or a dotted eighth; REAPER project BPM applies.
 srate*(60/max(20,tempo))/4*(M_EXT[16]<1.5?1:3);
);
function schedule_canon(e,pitch,event_t,dur,accent) local(j,slot,found) (
 found=-1;j=0;
 while(j<64 && found<0) (CAN_ON[j]<.5 ? found=j;j+=1;);
 found>=0 ? (
   slot=found;CAN_ON[slot]=1;CAN_AT[slot]=event_t+canon_delay_samples();
   CAN_PITCH[slot]=pitch+canon_interval();CAN_ACC[slot]=accent*clamp(M_EXT[18]/100,.05,1);
   CAN_DUR[slot]=dur*.72;CAN_ENG[slot]=e;
 );
);
function cascade_offset(at,mode,deg,root) local(v) (
  v=cascade_degrees(at);
  M_CFG[61]==0 ? v :
  M_CFG[61]==1 ? sc_int(v,mode) :
  sc_int(deg+v,mode)-sc_int(deg,mode);
);
function locked_anchor(st) (st%8==0||st%8==3||st%8==6;);
// Pitch and modulation have independent polymetric step counts.
function step_pitch(e,st) local(len) (
  len=iround(clamp(M_CFG[48+e],3,32));
  M_SEQ[e*32+(st%len)];
);
function gate_prob(e,st) local(len) (
  len=iround(clamp(M_CFG[52+e],3,32));
  M_GATE[e*32+(st%len)];
);
function vel_contour(e,st) local(len) (
  len=iround(clamp(M_CFG[52+e],3,32));
  M_VEL[e*32+(st%len)]/127;
);
function music_ratio(e) (max(.0625,pv(52+e*8))/4;);
function music_spacing(e) local(sec,beat,period,phase,role) (
  sec=M_CFG[2]<.5 ? slider256 : gdivision(M_CFG[3])*60/max(20,tempo);
  // For arp role, switch rates briefly every N bars. No additional notes are invented.
  role=iround(M_CFG[40+e]);role<=0 ? role=e+1;
  M_CFG[56]>.5 && role==2 && M_CFG[2]>.5 ? (
    beat=m_beat_at(ENGINE_NEXT[e]);period=max(1,M_CFG[58])*4;
    phase=beat-period*floor(beat/period);
    phase<2 ? sec/=max(1,iround(M_CFG[57]));
  );
  max(srate*.005,srate*sec/max(.0625,music_ratio(e)));
);
function harmonic_beat(evt) (
  ((slider3>.5 || (play_state&1)==0) ? run_samples/srate*max(20,tempo)/60 : beat_position)
  +(evt-clock_samples)/srate*max(20,tempo)/60;
);
function key_base() local(k,low) (
  low=iround(pv(5));k=iround(pv(7));
  low+(k-low%12+12)%12;
);
function clamp_key(p) local(low,high) (
  low=iround(pv(5));high=low+60;
  while(p<low) (p+=12;);
  while(p>high) (p-=12;);
  iround(clamp(p,low,high));
);
function arp_ix(pattern,st,n,e) local(ix,v) (
  n=max(1,n);st=iround(st);pattern=iround(pattern);
  pattern==0 ? ix=st%n :
  pattern==1 ? ix=n-1-(st%n) :
  pattern==2 ? ix=abs((st%(max(1,n*2-2)))-(n-1)) :
  pattern==3 ? ix=floor(rng()*n) :
  pattern==4 ? ix=(st*2)%n :
  pattern==5 ? ix=(st%2 ? n-1 : 0) :
  pattern==6 ? ix=(st%8==0?0:st%8==3?2:st%8==6?1:(st/2))%n :
  pattern==7 ? ix=(st*st+st+1)%n :
  pattern==8 ? ix=(st+floor(st/8))%n :
