// 1024-point stereo spectrum; channel magnitudes never cancel each other.
ui_frame+=1;
ui_frame>=3 ? (
  ui_frame=0;j=0;
  loop(1024,
    k=(spec_pos+j)%1024;w=fft_window[j];
    fft_in_l[j*2]=spec_in_l[k]*w;fft_in_l[j*2+1]=0;
    fft_in_r[j*2]=spec_in_r[k]*w;fft_in_r[j*2+1]=0;
    fft_out_l[j*2]=spec_out_l[k]*w;fft_out_l[j*2+1]=0;
    fft_out_r[j*2]=spec_out_r[k]*w;fft_out_r[j*2+1]=0;
    j+=1;
  );
  fft(fft_in_l,1024);fft_permute(fft_in_l,1024);
  fft(fft_in_r,1024);fft_permute(fft_in_r,1024);
  fft(fft_out_l,1024);fft_permute(fft_out_l,1024);
  fft(fft_out_r,1024);fft_permute(fft_out_r,1024);
);
px=62;py=670;pw=975;ph=115;maxfreq=min(6500,srate*0.48);
