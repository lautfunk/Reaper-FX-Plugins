label(900,652,"L/R PEAK / dBFS",$x6c8998,10);
i=0;
loop(4,
  gy=py+i*ph/3;color($x203440);gfx_line(px,gy,px+pw,gy);
  sprintf(#dbtick,"%d",-i*26);label(34,gy-5,#dbtick,$x5c7d8b,10);i+=1;
);
i=0;
loop(5,
  tickhz=i==0 ? 100 : i==1 ? 300 : i==2 ? 1000 : i==3 ? 3000 : maxfreq;
  gx=px+log(tickhz/100)/log(maxfreq/100)*pw;
  color($x203440);gfx_line(gx,py,gx,py+ph);
  sprintf(#freqtxt,"%d Hz",tickhz);gfx_setfont(1,"Arial",10);gfx_measurestr(#freqtxt,tw,th);
  label(max(px,min(px+pw-tw,gx-tw/2)),py+ph+9,#freqtxt,$x74929e,10);i+=1;
);
j=0;
loop(320,
  hz=100*(maxfreq/100)^(j/319);b=min(511,max(1,floor(hz*1024/srate)));
  mi=sqrt(max(fft_in_l[b*2]^2+fft_in_l[b*2+1]^2,fft_in_r[b*2]^2+fft_in_r[b*2+1]^2))/256;
  mo=sqrt(max(fft_out_l[b*2]^2+fft_out_l[b*2+1]^2,fft_out_r[b*2]^2+fft_out_r[b*2+1]^2))/256;
  di=max(-78,min(0,20*log10(max(mi,0.00001))));do_=max(-78,min(0,20*log10(max(mo,0.00001))));
  x=px+j*pw/319;yi=py+ph-(di+78)/78*ph;yo=py+ph-(do_+78)/78*ph;
  j>0 ? (
    color($x56d7d0);gfx_line(last_x,last_yi,x,yi,1);
    color($xffb66c);gfx_line(last_x,last_yo,x,yo,1);
  );
  last_x=x;last_yi=yi;last_yo=yo;j+=1;
);
slider23>=100 && slider23<=maxfreq ? (
  gx=px+log(slider23/100)/log(maxfreq/100)*pw;color($x56d7d0);gfx_line(gx,py,gx,py+ph,1);
);
ui_mapped>=100 && ui_mapped<=maxfreq ? (
