// Render to a fixed design canvas and scale the completed interface to fit.
ui_scale=min(gfx_w/1080,gfx_h/860);
ui_ox=(gfx_w-1080*ui_scale)/2;ui_oy=(gfx_h-860*ui_scale)/2;
ui_mx=(mouse_x-ui_ox)/max(0.01,ui_scale);ui_my=(mouse_y-ui_oy)/max(0.01,ui_scale);
ui_now=time_precise();
ui_click=(mouse_cap&1) && !(ui_last_mouse&1);
ui_release=!(mouse_cap&1) && (ui_last_mouse&1);
ui_wheel=mouse_wheel/120;mouse_wheel=0;
#ui_hint="LautFunk  /  Voice inversion effect  /  127 samples latency";
ui_edit>0 && ui_click && !inside(ui_edit_x,ui_edit_y,ui_edit_w,ui_edit_h) ? (
  !commit_edit() ? ui_edit=0;
);
ui_key=gfx_getchar();
while(ui_key>0) (
  ui_edit>0 ? (
    ui_key==13 ? commit_edit() : ui_key==27 ? ui_edit=0 :
    ui_key==1 ? ui_replace=1 :
    ui_key==8 || ui_key==127 ? (
      ui_replace ? #ui_text="" : str_setlen(#ui_text,max(0,strlen(#ui_text)-1));ui_replace=0;
    ) : (ui_key>=48 && ui_key<=57) || ui_key==45 || ui_key==43 || ui_key==46 || ui_key==44 ? (
      ui_replace ? (#ui_text="";ui_replace=0;);
      strlen(#ui_text)<14 ? sprintf(#ui_text,"%s%c",#ui_text,ui_key==44 ? 46 : ui_key);
    );
  );
  ui_key=gfx_getchar();
);
ui_drag>0 ? (
  mouse_cap&1 ? (
    ui_dragvalue+=((ui_drag_y-ui_my)+(ui_mx-ui_drag_x)*0.15)*(ui_dragmax-ui_dragmin)/180*((mouse_cap&8) ? 0.1 : 1);
    ui_dragvalue=min(ui_dragmax,max(ui_dragmin,ui_dragvalue));
    ui_v=min(ui_dragmax,max(ui_dragmin,floor(ui_dragvalue/ui_dragstep+0.5)*ui_dragstep));
    ui_v!=slider(ui_drag) ? ui_put(ui_drag,ui_v,0);
    ui_drag_y=ui_my;ui_drag_x=ui_mx;
  ) : (slider_automate(2^(ui_drag-1),1);ui_drag=0;);
);
ui_pressed_ptt && (!(mouse_cap&1) || !(gfx_getchar(65536)&2)) ? (
  ui_put(20,0,1);ui_pressed_ptt=0;
);
